{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": {
      "/nix/store/**": "allow",
      "/tmp/**": "allow",
      "/sys/**": "allow",
      "/proc/**": "allow",
      "/bin/**": "allow",
      "/boot/**": "allow",
      "/run/**": "allow",
      "/usr/**": "allow",
      "/etc/**": "allow",
      "/dev/**": "allow",
      "~/*": "allow",
      "~/.ssh/**": "deny",
      "~/.gnupg/**": "deny"
    }
  },
  "mcp": {
    "pdf-oxide": {
      "type": "local",
      "command": ["pdf-oxide-mcp"],
      "enabled": true
    },
    "google-patent": {
      "type": "local",
      "command": ["google-patent-cli", "mcp"],
      "enabled": true
    }
  },
  "autoupdate": false,
  "lsp": false,
  "formatter": false,
  "snapshot": false
}
