# Dmenu-like position
anchor = top
width = 100%
horizontal = true

# Height of bar
height = 36

# Padding
padding-top = 5
padding-bottom = 0
padding-left = 5
padding-right = 0

# Font size
font-size = 12
font = monospace
min-input-width = 120
result-spacing = 15

## Colors (current-theme is generated by home-manager: colorScheme.flavor)
include = /home/orhun/.config/tofi/current-theme

# Prompt
prompt-text = "Search: "

# Input
input-background-padding = 3
input-background-corner-radius = 8

# Border
border-width = 0

# Outline width
outline-width = 0
