#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -eq 0 ]; then
  echo "Usage: gtransfer <file>..."
  exit 1
fi

FILES=()
for file in "$@"; do
  FILES+=("$(realpath "$file")")
done

if [ "${#FILES[@]}" -eq 1 ]; then
  LABEL=$(basename "${FILES[0]}")
else
  LABEL="${#FILES[@]} files"
fi

PULL_SOCKET="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/gtransfer-pull.sock"

transfer_file() {
  if [[ ${TERM:-} == *"kitty"* ]]; then
    if command -v kitten > /dev/null 2>&1; then
      kitten transfer "$@" ./Downloads/
      return 0
    else
      echo "TERM claims to be '${TERM:-}', but 'kitten' binary not found."
      echo "(Did you ssh with 'kitty +kitten ssh user@host'?)"
    fi
  fi

  if [[ ${TERM_PROGRAM:-} == "WezTerm" ]] || [[ ${TERM_PROGRAM:-} == "iTerm.app" ]] || [[ ${LC_TERMINAL:-} == "iTerm2" ]]; then
    if command -v base64 > /dev/null 2>&1; then
      local src fn
      for src in "$@"; do
        fn=$(basename "$src")
        printf "\033]1337;File=name=%s;size=%d:" "$(echo -n "$fn" | base64 | tr -d '\n')" "$(wc -c < "$src")"
        base64 < "$src" | tr -d '\n'
        printf "\a"
      done
      return 0
    fi
  fi

  if command -v sz > /dev/null 2>&1; then
    sz --quiet "$@"
    return 0
  fi

  echo "Error: No suitable transfer method found."
  echo "  TERM: ${TERM:-}"
  echo "  TERM_PROGRAM: ${TERM_PROGRAM:-}"
  return 1
}

send_home() {
  if [ -S "$PULL_SOCKET" ]; then
    if printf '%s\0' "$@" | nc -N -U "$PULL_SOCKET"; then
      return 0
    fi
    echo "Nothing answers on $PULL_SOCKET (stale ssh forward), falling back to the terminal."
  fi
  transfer_file "$@"
}

IS_REMOTE=0
if [ -n "${SSH_CLIENT:-}" ] || [ -n "${SSH_TTY:-}" ] || [ -n "${SSH_CONNECTION:-}" ]; then
  IS_REMOTE=1
fi

MENU_ITEMS=""
if [ "$IS_REMOTE" -eq 1 ]; then
  MENU_ITEMS="back-home"$'\n'
fi
SSH_HOSTS=$(grep -hP "^Host " ~/.ssh/config ~/.ssh/config.local 2> /dev/null \
  | awk '{for (i=2; i<=NF; i++) print $i}' \
  | grep -F -v "*" || true)
MENU_ITEMS+="$SSH_HOSTS"

TARGET=$(echo -e "$MENU_ITEMS" | fzf --layout=reverse --prompt="Transfer $LABEL to > ") || exit 0

if [ -z "$TARGET" ]; then exit 0; fi

if [ "$TARGET" == "back-home" ]; then
  send_home "${FILES[@]}"
  exit 0
fi

echo "Connecting to $TARGET..."
REMOTE_TMP="/tmp/yazi_cwd_$$"
ssh -t "$TARGET" "bash -lc 'yazi --cwd-file \"$REMOTE_TMP\"'"
Q_REMOTE_TMP=$(printf %q "$REMOTE_TMP")
# shellcheck disable=SC2029
REMOTE_DIR=$(ssh "$TARGET" "cat $Q_REMOTE_TMP 2>/dev/null; rm -f $Q_REMOTE_TMP")
REMOTE_DIR=$(echo "$REMOTE_DIR" | tr -d '\r\n')

if [ -z "$REMOTE_DIR" ]; then
  echo "Cancelled."
  exit 0
fi

echo "Transferring to $TARGET:$REMOTE_DIR/"
if ssh "$TARGET" "command -v rsync >/dev/null 2>&1"; then
  rsync -avP "${FILES[@]}" "$TARGET":"$REMOTE_DIR/"
else
  scp -r "${FILES[@]}" "$TARGET":"$REMOTE_DIR/"
fi
