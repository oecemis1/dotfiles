#!/usr/bin/env bash
# Toggle the eww brightness slider, anchored under the backlight module.

SLIDER_WIDTH=340

if eww active-windows | grep -q "^brightness_slider"; then
    eww close brightness_slider
    exit
fi

WAYBAR_INFO=$(hyprctl layers -j | jq -r '.[].levels[][] | select(.namespace == "waybar")')
WAYBAR_WIDTH=$(echo "$WAYBAR_INFO" | jq -r '.w')
if [ -z "$WAYBAR_WIDTH" ] || [ "$WAYBAR_WIDTH" == "null" ]; then
    WAYBAR_WIDTH=$(hyprctl monitors -j | jq -r '.[0].width')
fi

# Right-aligned under the bar; offset by the bar's right margin.
X_POSITION=$((WAYBAR_WIDTH - SLIDER_WIDTH + 3))

eww open brightness_slider --arg x_pos="${X_POSITION}px" --arg y_pos="0px"
