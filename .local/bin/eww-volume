#!/usr/bin/env bash
# Get/set the default sink volume as a 0-100 integer (for the eww
# slider), plus mute state for the strip's speaker icon.

case "$1" in
    get)
        wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print int($2 * 100)}'
        ;;
    set)
        wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ "$2%"
        ;;
    muted)
        wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -q MUTED && echo true || echo false
        ;;
    mute-toggle)
        wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
        # push the new state so the icon flips instantly, not on the poll
        eww update cc_muted="$("$0" muted)" 2>/dev/null || true
        ;;
    *)
        echo "usage: eww-volume get|set <0-100>|muted|mute-toggle" >&2
        exit 1
        ;;
esac
