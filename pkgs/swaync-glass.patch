         private Notification () {}
+
+        internal bool glass_bounds (Gtk.Widget origin, out Graphene.Rect bounds,
+                                    out float radius, out Graphene.Rect clip) {
+            bounds = Graphene.Rect.zero ();
+            clip = Graphene.Rect.zero ();
+            radius = 0;
+            if (!get_mapped () || !base_widget.compute_bounds (origin, out bounds)
+                || bounds.size.width <= 0 || bounds.size.height <= 0) return false;
+            float base_radius = notification_type == NotificationType.FLOATING
+                ? GlassGeometry.SHEET_RADIUS : GlassGeometry.CARD_RADIUS;
+            Graphene.Matrix transform;
+            if (!base_widget.compute_transform (origin, out transform)) return false;
+            radius = base_radius * transform.get_x_scale ().abs ();
+            clip = Graphene.Rect ().init (0, 0, origin.get_width (), origin.get_height ());
+            for (unowned Gtk.Widget? parent = base_widget.get_parent ();
+                 parent != null && parent != origin; parent = parent.get_parent ()) {
+                if (parent is Gtk.Viewport || parent is Gtk.ScrolledWindow) {
+                    Graphene.Rect viewport_bounds, intersection;
+                    if (parent.compute_bounds (origin, out viewport_bounds)) {
+                        if (!clip.intersection (viewport_bounds, out intersection)) return false;
+                        clip = intersection;
+                    }
+                }
+            }
+            return bounds.intersection (clip, null);
+        }
+
+        internal void append_glass_mask (Gtk.Snapshot snapshot, Gtk.Widget origin) {
+            Graphene.Rect bounds, clip;
+            float radius;
+            if (!glass_bounds (origin, out bounds, out radius, out clip)) return;
+            Gsk.RoundedRect rounded = Gsk.RoundedRect ().init_from_rect (bounds, radius);
+            snapshot.push_rounded_clip (rounded);
+            snapshot.append_color (Gdk.RGBA () { red = 1, green = 1, blue = 1, alpha = 1 }, bounds);
+            snapshot.pop ();
+        }
 
