+namespace SwayNotificationCenter {
+    // One publisher per layer. Connections have independent snapshots, so a
+    // toast update never replaces the notification center or Quickshell geometry.
+    internal class GlassGeometry : Object {
+        public const float SHEET_RADIUS = 24;
+        public const float CARD_RADIUS = 18;
+        private const uint MAX_CARDS = 32;
+
+        private weak Gtk.Window owner;
+        private string layer_namespace;
+        private GlassBackdrop? backdrop;
+        private SocketConnection? connection;
+        private Cancellable cancellable = new Cancellable ();
+        private uint64 epoch = (uint64) GLib.get_real_time ();
+        private uint64 serial = 0;
+        private uint64 generation = 0;
+        private uint idle_id = 0;
+        private uint retry_id = 0;
+        private uint retry_delay = 250;
+        private bool writing = false;
+        private bool dirty = false;
+        private string last_geometry = "";
+
+        public GlassGeometry (Gtk.Window owner, string layer_namespace,
+                              GlassBackdrop? backdrop = null) {
+            this.owner = owner;
+            this.layer_namespace = layer_namespace;
+            this.backdrop = backdrop;
+            owner.map.connect (() => {
+                generation++;
+                schedule ();
+            });
+            owner.unmap.connect (schedule);
+        }
+
+        public override void dispose () {
+            cancellable.cancel ();
+            if (idle_id != 0) Source.remove (idle_id);
+            if (retry_id != 0) Source.remove (retry_id);
+            idle_id = 0;
+            retry_id = 0;
+            connection = null;
+            base.dispose ();
+        }
+
+        public void schedule () {
+            if (idle_id != 0 || cancellable.is_cancelled ()) return;
+            idle_id = Idle.add (() => {
+                idle_id = 0;
+                dirty = true;
+                if (!writing && retry_id == 0) write_geometry.begin ();
+                return Source.REMOVE;
+            });
+        }
+
+        private static string number (float value) {
+            return ((double) value).to_string ();
+        }
+
+        private string surface_record (string ns, string id, bool active) {
+            return "SURFACE\t%s\t%s\t%s\t%d\n".printf (
+                ns, id, generation.to_string (), active ? 1 : 0);
+        }
+
+        private string shape_record (string ns, string surface, string id, string role,
+                                     Graphene.Rect bounds, float radius, string clip) {
+            radius = float.min (radius, float.min (bounds.size.width, bounds.size.height) / 2);
+            return "SHAPE\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n".printf (
+                ns, surface, generation.to_string (), id, role,
+                number (bounds.origin.x), number (bounds.origin.y),
+                number (bounds.size.width), number (bounds.size.height), number (radius), clip);
+        }
+
+        private void collect (Gtk.Widget widget, StringBuilder shapes, StringBuilder clips,
+                              ref uint count) {
+            if (!widget.get_mapped () || !widget.get_child_visible () || widget.get_opacity () <= 0)
+                return;
+            if (widget is Notification) {
+                Graphene.Rect bounds;
+                Graphene.Rect clip;
+                float radius;
+                Notification notification = (Notification) widget;
+                if (!notification.glass_bounds (owner, out bounds, out radius, out clip)) return;
+                if (count >= MAX_CARDS) return;
+                string id = "notification.%u".printf (notification.param.applied_id);
+                string clip_id = "clip." + id;
+                shapes.append (shape_record (layer_namespace, "content", id, "stack",
+                                             bounds, radius, clip_id));
+                clips.append ("CLIP\t%s\tcontent\t%s\t%s\t%s\t%s\t%s\t%s\n".printf (
+                    layer_namespace, generation.to_string (), clip_id,
+                    number (clip.origin.x), number (clip.origin.y),
+                    number (clip.size.width), number (clip.size.height)));
+                count++;
+                return;
+            }
+            if (widget is ExpandableGroup) {
+                // GTK draws this list back-to-front; publish front-to-back for
+                // single-fragment ownership of overlapping notification cards.
+                unowned List<unowned Gtk.Widget>? link
+                    = ((ExpandableGroup) widget).visible_widgets.last ();
+                for (; link != null; link = link.prev) {
+                    collect (link.data, shapes, clips, ref count);
+                }
+                return;
+            }
+            for (unowned Gtk.Widget? child = widget.get_first_child ();
+                 child != null; child = child.get_next_sibling ()) {
+                collect (child, shapes, clips, ref count);
+            }
+        }
+
+        private string geometry (out uint count, out uint clip_count) {
+            bool active = owner != null && owner.get_mapped ();
+            StringBuilder surfaces = new StringBuilder (surface_record (
+                layer_namespace, "content", active));
+            StringBuilder shapes = new StringBuilder ();
+            StringBuilder clips = new StringBuilder ();
+            count = 0;
+            if (active) collect (owner, shapes, clips, ref count);
+            clip_count = count;
+            if (backdrop != null) {
+                Graphene.Rect bounds = Graphene.Rect.zero ();
+                bool sheet_active = active && backdrop.sheet_bounds (out bounds);
+                surfaces.append (surface_record (
+                    "swaync-control-center-backdrop", "backdrop", sheet_active));
+                if (sheet_active) {
+                    shapes.append (shape_record ("swaync-control-center-backdrop", "backdrop",
+                        "notification-center.sheet", "sheet", bounds, SHEET_RADIUS, "-"));
+                    count++;
+                }
+            }
+            return surfaces.str + shapes.str + clips.str;
+        }
+
+        private async void write_geometry () {
+            writing = true;
+            try {
+                if (connection == null) {
+                    string? signature = Environment.get_variable ("HYPRLAND_INSTANCE_SIGNATURE");
+                    if (signature == null || signature.length == 0) {
+                        writing = false;
+                        return;
+                    }
+                    string path = Path.build_filename (Environment.get_user_runtime_dir (),
+                                                       "hyprglass", signature + ".sock");
+                    SocketClient client = new SocketClient ();
+                    connection = yield client.connect_async (new UnixSocketAddress (path), cancellable);
+                    watch_connection.begin (connection);
+                    last_geometry = "";
+                    retry_delay = 250;
+                }
+                SocketConnection? current = connection;
+                while (current != null && connection == current
+                       && dirty && !cancellable.is_cancelled ()) {
+                    dirty = false;
+                    uint count, clip_count;
+                    string records = geometry (out count, out clip_count);
+                    if (records == last_geometry) continue;
+                    serial++;
+                    string frame = "BEGIN\t1\t%s\t%s\t%d\t%u\t%u\n%sCOMMIT\t%s\n".printf (
+                        epoch.to_string (), serial.to_string (), backdrop == null ? 1 : 2,
+                        count, clip_count, records, serial.to_string ());
+                    size_t written;
+                    yield current.output_stream.write_all_async (
+                        frame.data, Priority.DEFAULT, cancellable, out written);
+                    if (connection == current) last_geometry = records;
+                }
+            } catch (Error error) {
+                connection = null;
+                last_geometry = "";
+                reconnect_later ();
+            }
+            writing = false;
+            if (dirty && retry_id == 0) schedule ();
+        }
+
+        private void reconnect_later () {
+            dirty = true;
+            if (cancellable.is_cancelled () || retry_id != 0) return;
+            retry_id = Timeout.add (retry_delay, () => {
+                retry_id = 0;
+                if (!writing) write_geometry.begin ();
+                return Source.REMOVE;
+            });
+            retry_delay = uint.min (retry_delay * 2, 4000);
+        }
+
+        private async void watch_connection (SocketConnection current) {
+            uint8[] buffer = new uint8[1];
+            try {
+                while ((yield current.input_stream.read_async (
+                    buffer, Priority.DEFAULT, cancellable)) > 0) {}
+            } catch (Error error) {}
+            if (connection == current && !cancellable.is_cancelled ()) {
+                connection = null;
+                last_geometry = "";
+                reconnect_later ();
+            }
+        }
+    }
+
+    internal class GlassBackdrop : Gtk.Window {
+        private weak Gtk.Window owner;
+        private Gtk.Fixed layout = new Gtk.Fixed ();
+        private Gtk.Box sheet = new Gtk.Box (Gtk.Orientation.VERTICAL, 0);
+        public signal void geometry_changed ();
+
+        public GlassBackdrop (Gtk.Window owner) {
+            this.owner = owner;
+            add_css_class ("notification-glass-window");
+            sheet.add_css_class ("notification-center-backdrop");
+            set_child (layout);
+            layout.put (sheet, 0, 0);
+            set_can_focus (false);
+            GtkLayerShell.init_for_window (this);
+            GtkLayerShell.set_namespace (this, "swaync-control-center-backdrop");
+            GtkLayerShell.set_layer (this, GtkLayerShell.Layer.TOP);
+            GtkLayerShell.set_keyboard_mode (this, GtkLayerShell.KeyboardMode.NONE);
+            GtkLayerShell.set_exclusive_zone (this, -1);
+            owner.unmap.connect (() => set_visible (false));
+            this.map.connect (() => get_surface ().set_input_region (new Cairo.Region ()));
+        }
+
+        public void sync (Gtk.Widget panel) {
+            if (!owner.get_mapped ()) return;
+            Graphene.Rect bounds;
+            if (!panel.compute_bounds (owner, out bounds)) return;
+            GtkLayerShell.set_monitor (this, GtkLayerShell.get_monitor (owner)
+                ?? owner.get_display ().get_monitor_at_surface (owner.get_surface ()));
+            GtkLayerShell.Edge[] edges = {
+                GtkLayerShell.Edge.TOP, GtkLayerShell.Edge.RIGHT,
+                GtkLayerShell.Edge.BOTTOM, GtkLayerShell.Edge.LEFT,
+            };
+            foreach (GtkLayerShell.Edge edge in edges) {
+                GtkLayerShell.set_anchor (this, edge, GtkLayerShell.get_anchor (owner, edge));
+                GtkLayerShell.set_margin (this, edge, GtkLayerShell.get_margin (owner, edge));
+            }
+            layout.move (sheet, bounds.origin.x, bounds.origin.y);
+            sheet.set_size_request ((int) bounds.size.width, (int) bounds.size.height);
+            set_default_size (owner.get_width (), owner.get_height ());
+            set_visible (true);
+        }
+
+        public bool sheet_bounds (out Graphene.Rect bounds) {
+            bounds = Graphene.Rect.zero ();
+            return get_mapped () && sheet.compute_bounds (this, out bounds)
+                && bounds.size.width > 0 && bounds.size.height > 0;
+        }
+
+        protected override void size_allocate (int width, int height, int baseline) {
+            base.size_allocate (width, height, baseline);
+            geometry_changed ();
+        }
+    }
+}
