+
+  private:
+    Clip(std::string id, Rect bounds);
+
+    std::string m_id;
+    Rect        m_bounds;
+
+    friend class SnapshotBuilder;
+};
+
+class Shape {
+  public:
+    [[nodiscard]] std::string_view id() const { return m_id; }
+    [[nodiscard]] constexpr Role role() const { return m_role; }
+    [[nodiscard]] constexpr const Rect& bounds() const { return m_bounds; }
+    [[nodiscard]] constexpr float radius() const { return m_radius; }
+    [[nodiscard]] std::optional<std::string_view> clipId() const;
+
+  private:
+    Shape(std::string id, Role role, Rect bounds, float radius, std::string clipId);
+
+    std::string m_id;
+    Role        m_role;
+    Rect        m_bounds;
+    float       m_radius;
+    std::string m_clipId;
+
+    friend class SnapshotBuilder;
+};
+
+class Surface {
+  public:
+    [[nodiscard]] std::string_view layerNamespace() const { return m_namespace; }
+    [[nodiscard]] std::string_view id() const { return m_id; }
+    [[nodiscard]] constexpr std::uint64_t mappingGeneration() const { return m_mappingGeneration; }
+    [[nodiscard]] constexpr bool active() const { return m_active; }
+    [[nodiscard]] std::span<const Shape> shapes() const { return m_shapes; }
+    [[nodiscard]] std::span<const Clip> clips() const { return m_clips; }
+    [[nodiscard]] const Shape* findShape(std::string_view id) const;
+    [[nodiscard]] const Clip* findClip(std::string_view id) const;
+
+  private:
+    Surface(std::string layerNamespace, std::string id, std::uint64_t mappingGeneration,
+            bool active, std::vector<Shape> shapes, std::vector<Clip> clips);
+
+    std::string        m_namespace;
+    std::string        m_id;
+    std::uint64_t      m_mappingGeneration;
+    bool               m_active;
+    std::vector<Shape> m_shapes;
+    std::vector<Clip>  m_clips;
+
+    friend class SnapshotBuilder;
+};
+
+class Snapshot {
+  public:
+    [[nodiscard]] constexpr std::uint64_t epoch() const { return m_epoch; }
+    [[nodiscard]] constexpr std::uint64_t serial() const { return m_serial; }
+    [[nodiscard]] std::span<const Surface> surfaces() const { return m_surfaces; }
+    [[nodiscard]] const Surface* findSurface(std::string_view id) const;
+
+  private:
+    Snapshot(std::uint64_t epoch, std::uint64_t serial, std::vector<Surface> surfaces);
+
+    std::uint64_t        m_epoch;
+    std::uint64_t        m_serial;
+    std::vector<Surface> m_surfaces;
+
+    friend class SnapshotBuilder;
+};
+
+class Lookup {
+  public:
+    [[nodiscard]] const std::shared_ptr<const Snapshot>& owner() const { return m_owner; }
+    [[nodiscard]] const Snapshot& snapshot() const { return *m_owner; }
+    [[nodiscard]] const Surface& surface() const;
+    [[nodiscard]] std::span<const Shape> shapes() const { return surface().shapes(); }
+    [[nodiscard]] std::span<const Clip> clips() const { return surface().clips(); }
+
+  private:
+    Lookup(std::shared_ptr<const Snapshot> owner, std::size_t surfaceIndex);
+
+    std::shared_ptr<const Snapshot> m_owner;
+    std::size_t                     m_surfaceIndex;
+
+    friend class State;
+};
+
+struct LayerDamageEffect {
+    LayerToken        layer;
+    std::vector<Rect> oldShapeBounds;
+    std::vector<Rect> newShapeBounds;
+    bool              fullLayer = false;
+};
+
+struct UpdateResult {
+    std::size_t                   acceptedTransactions = 0;
+    std::size_t                   rejectedTransactions = 0;
+    std::vector<LayerDamageEffect> layerEffects;
+
+    [[nodiscard]] bool empty() const {
+        return acceptedTransactions == 0 && rejectedTransactions == 0 && layerEffects.empty();
+    }
+};
+
+class State {
+  public:
+    State();
+    ~State();
+    State(State&&) noexcept;
+    State& operator=(State&&) noexcept;
+    State(const State&) = delete;
+    State& operator=(const State&) = delete;
+
+    [[nodiscard]] UpdateResult clientConnected();
+    [[nodiscard]] UpdateResult ingest(std::string_view bytes);
+    [[nodiscard]] UpdateResult clientDisconnected();
+    [[nodiscard]] UpdateResult layerMapped(LayerToken token, std::string_view layerNamespace);
+    [[nodiscard]] UpdateResult layerUnmapped(LayerToken token);
+    [[nodiscard]] std::optional<Lookup> lookup(LayerToken token) const;
+    [[nodiscard]] std::shared_ptr<const Snapshot> active() const;
+
+  private:
+    class Impl;
+    std::unique_ptr<Impl> m_impl;
+};
+
+} // namespace SemanticGeometry
