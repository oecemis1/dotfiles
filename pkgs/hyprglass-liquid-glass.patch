+    OUT_OF_RANGE,
+    FRACTIONAL_ITERATIONS,
+    CENTERED_NONFINITE,
+    CENTERED_UNBOUNDED,
+    CENTERED_ASYMMETRIC,
+    CENTERED_CENTER_CROSSING,
+    SNELL_PROFILE,
