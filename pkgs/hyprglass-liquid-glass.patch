@@ -0,0 +1,742 @@
+#include "SemanticGeometry.hpp"
+
+#include <algorithm>
+#include <charconv>
+#include <cmath>
+#include <limits>
+#include <optional>
+#include <string>
+#include <unordered_map>
+#include <unordered_set>
+#include <utility>
+#include <vector>
+
+namespace SemanticGeometry {
+
+Clip::Clip(std::string id, Rect bounds) : m_id(std::move(id)), m_bounds(bounds) {}
+
+Shape::Shape(std::string id, Role role, Rect bounds, float radius, std::string clipId) :
+    m_id(std::move(id)), m_role(role), m_bounds(bounds), m_radius(radius), m_clipId(std::move(clipId)) {}
+
+std::optional<std::string_view> Shape::clipId() const {
+    if (m_clipId.empty())
+        return std::nullopt;
+    return m_clipId;
+}
+
+Surface::Surface(std::string layerNamespace, std::string id, std::uint64_t mappingGeneration,
+                 bool active, std::vector<Shape> shapes, std::vector<Clip> clips) :
+    m_namespace(std::move(layerNamespace)), m_id(std::move(id)), m_mappingGeneration(mappingGeneration),
+    m_active(active), m_shapes(std::move(shapes)), m_clips(std::move(clips)) {}
+
+const Shape* Surface::findShape(std::string_view id) const {
+    const auto found = std::ranges::find(m_shapes, id, &Shape::id);
+    return found == m_shapes.end() ? nullptr : &*found;
+}
+
+const Clip* Surface::findClip(std::string_view id) const {
+    const auto found = std::ranges::find(m_clips, id, &Clip::id);
+    return found == m_clips.end() ? nullptr : &*found;
+}
+
+Snapshot::Snapshot(std::uint64_t epoch, std::uint64_t serial, std::vector<Surface> surfaces) :
+    m_epoch(epoch), m_serial(serial), m_surfaces(std::move(surfaces)) {}
+
+const Surface* Snapshot::findSurface(std::string_view id) const {
+    const auto found = std::ranges::find(m_surfaces, id, &Surface::id);
+    return found == m_surfaces.end() ? nullptr : &*found;
+}
+
+Lookup::Lookup(std::shared_ptr<const Snapshot> owner, std::size_t surfaceIndex) :
+    m_owner(std::move(owner)), m_surfaceIndex(surfaceIndex) {}
+
+const Surface& Lookup::surface() const {
+    return m_owner->surfaces()[m_surfaceIndex];
+}
+
+namespace {
+
+struct PendingSurface {
+    std::string   layerNamespace;
+    std::string   id;
+    std::uint64_t mappingGeneration;
+    bool          active;
+};
+
+struct PendingClip {
+    std::string   layerNamespace;
+    std::string   surfaceId;
+    std::uint64_t mappingGeneration;
+    std::string   id;
+    Rect          bounds;
+};
+
+struct PendingShape {
+    std::string   layerNamespace;
+    std::string   surfaceId;
+    std::uint64_t mappingGeneration;
+    std::string   id;
+    Role          role;
+    Rect          bounds;
+    struct {
+        double x;
+        double y;
+        double width;
+        double height;
+    } sourceBounds;
+    float         radius;
+    std::string   clipId;
+};
+
+struct PendingTransaction {
+    std::uint64_t              epoch;
+    std::uint64_t              serial;
+    std::size_t                declaredSurfaces;
+    std::size_t                declaredShapes;
+    std::size_t                declaredClips;
+    std::size_t                wireBytes;
+    bool                       valid = true;
+    std::vector<PendingSurface> surfaces;
+    std::vector<PendingShape>   shapes;
+    std::vector<PendingClip>    clips;
+};
+
+struct Binding {
+    std::shared_ptr<const Snapshot> owner;
+    std::size_t                     surfaceIndex;
+};
+
+using LayerMap = std::unordered_map<LayerToken, std::string>;
+
+[[nodiscard]] bool isIdentifier(std::string_view value) {
+    if (value.empty() || value == "-")
+        return false;
+    return std::ranges::all_of(value, [](char character) {
+        return (character >= 'A' && character <= 'Z') ||
+            (character >= 'a' && character <= 'z') ||
+            (character >= '0' && character <= '9') ||
+            character == '.' || character == '_' || character == ':' || character == '-';
+    });
+}
+
+[[nodiscard]] std::optional<std::uint64_t> parseUnsigned(std::string_view value) {
+    if (value.empty())
+        return std::nullopt;
+    std::uint64_t parsed = 0;
+    for (const char character : value) {
+        if (character < '0' || character > '9')
+            return std::nullopt;
+        const auto digit = static_cast<std::uint64_t>(character - '0');
+        if (parsed > (std::numeric_limits<std::uint64_t>::max() - digit) / 10U)
+            return std::nullopt;
+        parsed = parsed * 10U + digit;
+    }
+    return parsed;
+}
+
+struct ParsedGeometry {
+    double source;
+    float  stored;
+};
+
+[[nodiscard]] std::optional<ParsedGeometry> parseGeometry(std::string_view value) {
+    if (value.empty())
+        return std::nullopt;
+    double parsed = 0.0;
+    const auto result = std::from_chars(value.data(), value.data() + value.size(), parsed, std::chars_format::general);
+    if (result.ec != std::errc{} || result.ptr != value.data() + value.size() || !std::isfinite(parsed) ||
+        std::abs(parsed) > std::numeric_limits<float>::max())
+        return std::nullopt;
+    const float stored = static_cast<float>(parsed);
+    if (!std::isfinite(stored))
+        return std::nullopt;
+    return ParsedGeometry{parsed, stored};
+}
+
+[[nodiscard]] bool hasFiniteDerivedGeometry(const Rect& bounds) {
+    const float right = bounds.x + bounds.width;
+    const float bottom = bounds.y + bounds.height;
+    const float centerX = bounds.x + bounds.width * 0.5F;
+    const float centerY = bounds.y + bounds.height * 0.5F;
+    return std::isfinite(right) && std::isfinite(bottom) && std::isfinite(centerX) && std::isfinite(centerY);
+}
+
+[[nodiscard]] std::vector<std::string_view> splitFields(std::string_view record) {
+    std::vector<std::string_view> fields;
+    std::size_t start = 0;
+    while (true) {
+        const std::size_t tab = record.find('\t', start);
+        if (tab == std::string_view::npos) {
+            fields.push_back(record.substr(start));
+            return fields;
+        }
+        fields.push_back(record.substr(start, tab - start));
+        start = tab + 1;
+    }
+}
+
+[[nodiscard]] std::optional<PendingTransaction> parseBegin(
+    const std::vector<std::string_view>& fields, std::size_t wireBytes) {
+    if (fields.size() != 7 || fields[0] != "BEGIN" || fields[1] != "1")
+        return std::nullopt;
+    const auto epoch = parseUnsigned(fields[2]);
+    const auto serial = parseUnsigned(fields[3]);
+    const auto surfaceCount = parseUnsigned(fields[4]);
+    const auto shapeCount = parseUnsigned(fields[5]);
+    const auto clipCount = parseUnsigned(fields[6]);
+    if (!epoch || !serial || !surfaceCount || !shapeCount || !clipCount)
+        return std::nullopt;
+
+    PendingTransaction transaction{
+        .epoch = *epoch,
+        .serial = *serial,
+        .declaredSurfaces = 0,
+        .declaredShapes = 0,
+        .declaredClips = 0,
+        .wireBytes = wireBytes,
+        .valid = true,
+        .surfaces = {},
+        .shapes = {},
+        .clips = {},
+    };
+    if (*surfaceCount > MAX_SURFACES || *shapeCount > MAX_SHAPES || *clipCount > MAX_CLIPS) {
+        transaction.valid = false;
+        return transaction;
+    }
+    transaction.declaredSurfaces = static_cast<std::size_t>(*surfaceCount);
+    transaction.declaredShapes = static_cast<std::size_t>(*shapeCount);
+    transaction.declaredClips = static_cast<std::size_t>(*clipCount);
+    transaction.surfaces.reserve(transaction.declaredSurfaces);
+    transaction.shapes.reserve(transaction.declaredShapes);
+    transaction.clips.reserve(transaction.declaredClips);
+    return transaction;
+}
+
+[[nodiscard]] std::optional<PendingSurface> parseSurface(const std::vector<std::string_view>& fields) {
+    if (fields.size() != 5 || fields[0] != "SURFACE" || !isIdentifier(fields[1]) || !isIdentifier(fields[2]))
+        return std::nullopt;
+    const auto generation = parseUnsigned(fields[3]);
+    if (!generation || (fields[4] != "0" && fields[4] != "1"))
+        return std::nullopt;
+    return PendingSurface{std::string(fields[1]), std::string(fields[2]), *generation, fields[4] == "1"};
+}
+
+[[nodiscard]] std::optional<PendingClip> parseClip(const std::vector<std::string_view>& fields) {
+    if (fields.size() != 9 || fields[0] != "CLIP" || !isIdentifier(fields[1]) ||
+        !isIdentifier(fields[2]) || !isIdentifier(fields[4]))
+        return std::nullopt;
+    const auto generation = parseUnsigned(fields[3]);
+    const auto x = parseGeometry(fields[5]);
+    const auto y = parseGeometry(fields[6]);
+    const auto width = parseGeometry(fields[7]);
+    const auto height = parseGeometry(fields[8]);
+    if (!generation || !x || !y || !width || !height || width->source < 0.0 || height->source < 0.0)
+        return std::nullopt;
+    const Rect bounds{x->stored, y->stored, width->stored, height->stored};
+    if (!hasFiniteDerivedGeometry(bounds))
+        return std::nullopt;
+    return PendingClip{
+        std::string(fields[1]), std::string(fields[2]), *generation,
+        std::string(fields[4]), bounds,
+    };
+}
+
+[[nodiscard]] std::optional<PendingShape> parseShape(const std::vector<std::string_view>& fields) {
+    if (fields.size() != 12 || fields[0] != "SHAPE" || !isIdentifier(fields[1]) ||
+        !isIdentifier(fields[2]) || !isIdentifier(fields[4]))
+        return std::nullopt;
+    const auto generation = parseUnsigned(fields[3]);
+    const auto x = parseGeometry(fields[6]);
+    const auto y = parseGeometry(fields[7]);
+    const auto width = parseGeometry(fields[8]);
+    const auto height = parseGeometry(fields[9]);
+    const auto radius = parseGeometry(fields[10]);
+    if (!generation || !x || !y || !width || !height || !radius ||
+        width->source <= 0.0 || height->source <= 0.0 || width->stored <= 0.0F || height->stored <= 0.0F)
+        return std::nullopt;
+
+    Role role;
+    if (fields[5] == "sheet")
+        role = Role::SHEET;
+    else if (fields[5] == "control")
+        role = Role::CONTROL;
+    else
+        return std::nullopt;
+
+    std::string clipId;
+    if (fields[11].find(',') != std::string_view::npos)
+        return std::nullopt;
+    if (fields[11] != "-") {
+        if (!isIdentifier(fields[11]))
+            return std::nullopt;
+        clipId = fields[11];
+    }
+    const Rect bounds{x->stored, y->stored, width->stored, height->stored};
+    if (!hasFiniteDerivedGeometry(bounds) || radius->source < 0.0 ||
+        radius->source > std::min(width->source, height->source) * 0.5 ||
+        radius->stored > std::min(width->stored, height->stored) * 0.5F)
+        return std::nullopt;
+    return PendingShape{
+        std::string(fields[1]), std::string(fields[2]), *generation, std::string(fields[4]),
+        role, bounds, {x->source, y->source, width->source, height->source}, radius->stored, std::move(clipId),
+    };
+}
+
+template <typename Bounds>
+[[nodiscard]] bool rectanglesOverlap(const Bounds& left, const Bounds& right) {
+    return left.x < right.x + right.width && right.x < left.x + left.width &&
+        left.y < right.y + right.height && right.y < left.y + left.height;
+}
+
+[[nodiscard]] bool validateTransaction(const PendingTransaction& transaction) {
+    if (!transaction.valid || transaction.surfaces.size() != transaction.declaredSurfaces ||
+        transaction.shapes.size() != transaction.declaredShapes || transaction.clips.size() != transaction.declaredClips)
+        return false;
+
+    std::unordered_map<std::string_view, const PendingSurface*> surfaces;
+    for (const auto& surface : transaction.surfaces) {
+        if (!surfaces.emplace(surface.id, &surface).second)
+            return false;
+    }
+
+    std::unordered_map<std::string_view, const PendingClip*> clips;
+    for (const auto& clip : transaction.clips) {
+        if (!clips.emplace(clip.id, &clip).second)
+            return false;
+        const auto surface = surfaces.find(clip.surfaceId);
+        if (surface == surfaces.end() || surface->second->layerNamespace != clip.layerNamespace ||
+            surface->second->mappingGeneration != clip.mappingGeneration)
+            return false;
+    }
+
+    std::unordered_set<std::string_view> shapeIds;
+    for (const auto& shape : transaction.shapes) {
+        if (!shapeIds.emplace(shape.id).second)
+            return false;
+        const auto surface = surfaces.find(shape.surfaceId);
+        if (surface == surfaces.end() || surface->second->layerNamespace != shape.layerNamespace ||
+            surface->second->mappingGeneration != shape.mappingGeneration)
+            return false;
+        if (!shape.clipId.empty()) {
+            const auto clip = clips.find(shape.clipId);
+            if (clip == clips.end() || clip->second->surfaceId != shape.surfaceId ||
+                clip->second->layerNamespace != shape.layerNamespace ||
+                clip->second->mappingGeneration != shape.mappingGeneration)
+                return false;
+        }
+    }
+
+    for (std::size_t leftIndex = 0; leftIndex < transaction.shapes.size(); ++leftIndex) {
+        const auto& left = transaction.shapes[leftIndex];
+        const auto surface = surfaces.at(left.surfaceId);
+        if (!surface->active)
+            continue;
+        for (std::size_t rightIndex = leftIndex + 1; rightIndex < transaction.shapes.size(); ++rightIndex) {
+            const auto& right = transaction.shapes[rightIndex];
+            if (left.surfaceId == right.surfaceId &&
+                (rectanglesOverlap(left.sourceBounds, right.sourceBounds) || rectanglesOverlap(left.bounds, right.bounds)))
+                return false;
+        }
+    }
+    return true;
+}
+
+[[nodiscard]] std::optional<Binding> bindingFor(
+    LayerToken token, const LayerMap& layers, const std::shared_ptr<const Snapshot>& snapshot) {
+    const auto mapped = layers.find(token);
+    if (mapped == layers.end() || !snapshot)
+        return std::nullopt;
+    const std::size_t mappedCount = static_cast<std::size_t>(std::ranges::count(layers, mapped->second, &LayerMap::value_type::second));
+    if (mappedCount != 1)
+        return std::nullopt;
+
+    std::optional<std::size_t> surfaceIndex;
+    const auto surfaces = snapshot->surfaces();
+    for (std::size_t index = 0; index < surfaces.size(); ++index) {
+        if (!surfaces[index].active() || surfaces[index].layerNamespace() != mapped->second)
+            continue;
+        if (surfaceIndex)
+            return std::nullopt;
+        surfaceIndex = index;
+    }
+    if (!surfaceIndex)
+        return std::nullopt;
+    return Binding{snapshot, *surfaceIndex};
+}
+
+[[nodiscard]] const Surface& boundSurface(const Binding& binding) {
+    return binding.owner->surfaces()[binding.surfaceIndex];
+}
+
+[[nodiscard]] bool sameBindingIdentity(const Binding& left, const Binding& right) {
+    const auto& leftSurface = boundSurface(left);
+    const auto& rightSurface = boundSurface(right);
+    return leftSurface.layerNamespace() == rightSurface.layerNamespace() && leftSurface.id() == rightSurface.id() &&
+        leftSurface.mappingGeneration() == rightSurface.mappingGeneration();
+}
+
+void addUniqueRect(std::vector<Rect>& bounds, const Rect& value) {
+    if (std::ranges::find(bounds, value) == bounds.end())
+        bounds.push_back(value);
+}
+
+void addAllShapes(std::vector<Rect>& bounds, const Surface& surface) {
+    for (const auto& shape : surface.shapes())
+        addUniqueRect(bounds, shape.bounds());
+}
+
+[[nodiscard]] bool referencedClipChanged(
+    const Surface& oldSurface, const Shape& oldShape,
+    const Surface& newSurface, const Shape& newShape) {
+    if (oldShape.clipId() != newShape.clipId())
+        return true;
+    if (!oldShape.clipId())
+        return false;
+    const Clip* oldClip = oldSurface.findClip(*oldShape.clipId());
+    const Clip* newClip = newSurface.findClip(*newShape.clipId());
+    return oldClip == nullptr || newClip == nullptr || oldClip->bounds() != newClip->bounds();
+}
+
+[[nodiscard]] std::optional<LayerDamageEffect> damageForBindings(
+    LayerToken token, const std::optional<Binding>& oldBinding, const std::optional<Binding>& newBinding) {
+    if (!oldBinding && !newBinding)
+        return std::nullopt;
+
+    LayerDamageEffect effect{
+        .layer = token,
+        .oldShapeBounds = {},
+        .newShapeBounds = {},
+        .fullLayer = false,
+    };
+    effect.fullLayer = oldBinding.has_value() != newBinding.has_value() ||
+        (oldBinding && newBinding && !sameBindingIdentity(*oldBinding, *newBinding));
+
+    if (!oldBinding) {
+        addAllShapes(effect.newShapeBounds, boundSurface(*newBinding));
+    } else if (!newBinding) {
+        addAllShapes(effect.oldShapeBounds, boundSurface(*oldBinding));
+    } else if (!sameBindingIdentity(*oldBinding, *newBinding)) {
+        addAllShapes(effect.oldShapeBounds, boundSurface(*oldBinding));
+        addAllShapes(effect.newShapeBounds, boundSurface(*newBinding));
+    } else {
+        const auto& oldSurface = boundSurface(*oldBinding);
+        const auto& newSurface = boundSurface(*newBinding);
+        for (const auto& oldShape : oldSurface.shapes()) {
+            const Shape* newShape = newSurface.findShape(oldShape.id());
+            if (newShape == nullptr) {
+                addUniqueRect(effect.oldShapeBounds, oldShape.bounds());
+                continue;
+            }
+            const bool changed = oldShape.bounds() != newShape->bounds() || oldShape.radius() != newShape->radius() ||
+                referencedClipChanged(oldSurface, oldShape, newSurface, *newShape);
+            if (changed) {
+                addUniqueRect(effect.oldShapeBounds, oldShape.bounds());
+                addUniqueRect(effect.newShapeBounds, newShape->bounds());
+            }
+        }
+        for (const auto& newShape : newSurface.shapes()) {
+            if (oldSurface.findShape(newShape.id()) == nullptr)
+                addUniqueRect(effect.newShapeBounds, newShape.bounds());
+        }
+    }
+
+    if (!effect.fullLayer && effect.oldShapeBounds.empty() && effect.newShapeBounds.empty())
+        return std::nullopt;
+    return effect;
+}
+
+void appendEffect(UpdateResult& result, LayerDamageEffect effect) {
+    const auto existing = std::ranges::find(result.layerEffects, effect.layer, &LayerDamageEffect::layer);
+    if (existing == result.layerEffects.end()) {
+        result.layerEffects.push_back(std::move(effect));
+        return;
+    }
+    existing->fullLayer = existing->fullLayer || effect.fullLayer;
+    for (const auto& bounds : effect.oldShapeBounds)
+        addUniqueRect(existing->oldShapeBounds, bounds);
+    for (const auto& bounds : effect.newShapeBounds)
+        addUniqueRect(existing->newShapeBounds, bounds);
+}
+
+void appendBindingChanges(
+    UpdateResult& result,
+    const LayerMap& oldLayers, const std::shared_ptr<const Snapshot>& oldSnapshot,
+    const LayerMap& newLayers, const std::shared_ptr<const Snapshot>& newSnapshot) {
+    std::vector<LayerToken> tokens;
+    tokens.reserve(oldLayers.size() + newLayers.size());
+    for (const auto& [token, _] : oldLayers)
+        tokens.push_back(token);
+    for (const auto& [token, _] : newLayers)
+        tokens.push_back(token);
+    std::ranges::sort(tokens);
+    tokens.erase(std::unique(tokens.begin(), tokens.end()), tokens.end());
+
+    for (const LayerToken token : tokens) {
+        auto effect = damageForBindings(
+            token, bindingFor(token, oldLayers, oldSnapshot), bindingFor(token, newLayers, newSnapshot));
+        if (effect)
+            appendEffect(result, std::move(*effect));
+    }
+}
+
+} // namespace
+
+class SnapshotBuilder {
+  public:
+    [[nodiscard]] static std::shared_ptr<const Snapshot> build(const PendingTransaction& transaction) {
+        std::vector<Surface> surfaces;
+        surfaces.reserve(transaction.surfaces.size());
+        for (const auto& pendingSurface : transaction.surfaces) {
+            std::vector<Shape> shapes;
+            std::vector<Clip> clips;
+            for (const auto& pendingShape : transaction.shapes) {
+                if (pendingShape.surfaceId == pendingSurface.id) {
+                    shapes.push_back(Shape(
+                        pendingShape.id, pendingShape.role, pendingShape.bounds,
+                        pendingShape.radius, pendingShape.clipId));
+                }
+            }
+            for (const auto& pendingClip : transaction.clips) {
+                if (pendingClip.surfaceId == pendingSurface.id)
+                    clips.push_back(Clip(pendingClip.id, pendingClip.bounds));
+            }
+            surfaces.push_back(Surface(
+                pendingSurface.layerNamespace, pendingSurface.id, pendingSurface.mappingGeneration,
+                pendingSurface.active, std::move(shapes), std::move(clips)));
+        }
+        return std::shared_ptr<const Snapshot>(new Snapshot(transaction.epoch, transaction.serial, std::move(surfaces)));
+    }
+};
+
+class State::Impl {
+  public:
+    [[nodiscard]] UpdateResult connected() {
+        UpdateResult result;
+        clearFraming();
+        m_connectionEpoch.reset();
+        m_connected = true;
+        if (m_active) {
+            const auto old = std::exchange(m_active, {});
+            appendBindingChanges(result, m_layers, old, m_layers, m_active);
+        }
+        return result;
+    }
+
+    [[nodiscard]] UpdateResult ingest(std::string_view bytes) {
+        UpdateResult result;
+        if (!m_connected)
+            return result;
+
+        for (const char character : bytes) {
+            accountTransactionByte();
+            if (character == '\n') {
+                if (m_recordOverflow)
+                    processOversizedRecord();
+                else
+                    processRecord(m_recordBuffer, result);
+                m_recordBuffer.clear();
+                m_recordOverflow = false;
+                continue;
+            }
+            if (m_recordOverflow)
+                continue;
+            if (m_recordBuffer.size() == MAX_RECORD_BYTES) {
+                m_recordOverflow = true;
+                continue;
+            }
+            m_recordBuffer.push_back(character);
+        }
+        return result;
+    }
+
+    [[nodiscard]] UpdateResult disconnected() {
+        UpdateResult result;
+        clearFraming();
+        m_connectionEpoch.reset();
+        m_connected = false;
+        if (m_active) {
+            const auto old = std::exchange(m_active, {});
+            appendBindingChanges(result, m_layers, old, m_layers, m_active);
+        }
+        return result;
+    }
+
+    [[nodiscard]] UpdateResult mapped(LayerToken token, std::string_view layerNamespace) {
+        UpdateResult result;
+        if (!isIdentifier(layerNamespace))
+            return result;
+        const auto existing = m_layers.find(token);
+        if (existing != m_layers.end() && existing->second == layerNamespace)
+            return result;
+        const LayerMap oldLayers = m_layers;
+        m_layers.insert_or_assign(token, std::string(layerNamespace));
+        appendBindingChanges(result, oldLayers, m_active, m_layers, m_active);
+        return result;
+    }
+
+    [[nodiscard]] UpdateResult unmapped(LayerToken token) {
+        UpdateResult result;
+        if (!m_layers.contains(token))
+            return result;
+        const LayerMap oldLayers = m_layers;
+        m_layers.erase(token);
+        appendBindingChanges(result, oldLayers, m_active, m_layers, m_active);
+        return result;
+    }
+
+    [[nodiscard]] std::optional<Binding> binding(LayerToken token) const {
+        return bindingFor(token, m_layers, m_active);
+    }
+
+    [[nodiscard]] std::shared_ptr<const Snapshot> active() const {
+        return m_active;
+    }
+
+  private:
+    void clearFraming() {
+        m_recordBuffer.clear();
+        m_recordOverflow = false;
+        m_transaction.reset();
+    }
+
+    void accountTransactionByte() {
+        if (!m_transaction || m_transaction->wireBytes > MAX_TRANSACTION_BYTES)
+            return;
+        ++m_transaction->wireBytes;
+        if (m_transaction->wireBytes > MAX_TRANSACTION_BYTES)
+            m_transaction->valid = false;
+    }
+
+    void processOversizedRecord() {
+        if (m_transaction)
+            m_transaction->valid = false;
+    }
+
+    void processRecord(std::string_view record, UpdateResult& result) {
+        const auto fields = splitFields(record);
+        if (!fields.empty() && fields[0] == "BEGIN") {
+            if (m_transaction) {
+                ++result.rejectedTransactions;
+                m_transaction.reset();
+            }
+            auto transaction = parseBegin(fields, record.size() + 1);
+            if (!transaction) {
+                ++result.rejectedTransactions;
+                return;
+            }
+            if ((m_connectionEpoch && *m_connectionEpoch != transaction->epoch) ||
+                (m_lastSerialByEpoch.contains(transaction->epoch) &&
+                 transaction->serial <= m_lastSerialByEpoch.at(transaction->epoch)) ||
+                (!m_lastSerialByEpoch.contains(transaction->epoch) &&
+                 m_lastSerialByEpoch.size() == MAX_TRACKED_EPOCHS))
+                transaction->valid = false;
+            m_transaction = std::move(*transaction);
+            return;
+        }
+
+        if (!m_transaction)
+            return;
+        if (!fields.empty() && fields[0] == "COMMIT") {
+            const auto serial = fields.size() == 2 ? parseUnsigned(fields[1]) : std::nullopt;
+            if (!serial || *serial != m_transaction->serial)
+                m_transaction->valid = false;
+            commit(result);
+            return;
+        }
+        if (!m_transaction->valid)
+            return;
+
+        if (!fields.empty() && fields[0] == "SURFACE") {
+            auto surface = parseSurface(fields);
+            if (!surface || m_transaction->surfaces.size() == MAX_SURFACES) {
+                m_transaction->valid = false;
+                return;
+            }
+            m_transaction->surfaces.push_back(std::move(*surface));
+            return;
+        }
+        if (!fields.empty() && fields[0] == "CLIP") {
+            auto clip = parseClip(fields);
+            if (!clip || m_transaction->clips.size() == MAX_CLIPS) {
+                m_transaction->valid = false;
+                return;
+            }
+            m_transaction->clips.push_back(std::move(*clip));
+            return;
+        }
+        if (!fields.empty() && fields[0] == "SHAPE") {
+            auto shape = parseShape(fields);
+            if (!shape || m_transaction->shapes.size() == MAX_SHAPES) {
+                m_transaction->valid = false;
+                return;
+            }
+            m_transaction->shapes.push_back(std::move(*shape));
+            return;
+        }
+        m_transaction->valid = false;
+    }
+
+    void commit(UpdateResult& result) {
+        PendingTransaction transaction = std::move(*m_transaction);
+        m_transaction.reset();
+        if (!validateTransaction(transaction)) {
+            ++result.rejectedTransactions;
+            return;
+        }
+
+        auto snapshot = SnapshotBuilder::build(transaction);
+        const auto old = m_active;
+        m_active = std::move(snapshot);
+        m_connectionEpoch = transaction.epoch;
+        m_lastSerialByEpoch.insert_or_assign(transaction.epoch, transaction.serial);
+        ++result.acceptedTransactions;
+        appendBindingChanges(result, m_layers, old, m_layers, m_active);
+    }
+
+    bool                            m_connected = false;
+    std::string                     m_recordBuffer;
+    bool                            m_recordOverflow = false;
+    std::optional<PendingTransaction> m_transaction;
+    std::optional<std::uint64_t>    m_connectionEpoch;
+    std::unordered_map<std::uint64_t, std::uint64_t> m_lastSerialByEpoch;
+    std::shared_ptr<const Snapshot> m_active;
+    LayerMap                        m_layers;
+};
+
+State::State() : m_impl(std::make_unique<Impl>()) {}
+State::~State() = default;
+State::State(State&&) noexcept = default;
+State& State::operator=(State&&) noexcept = default;
+
+UpdateResult State::clientConnected() {
+    return m_impl->connected();
+}
+
+UpdateResult State::ingest(std::string_view bytes) {
+    return m_impl->ingest(bytes);
+}
+
+UpdateResult State::clientDisconnected() {
+    return m_impl->disconnected();
+}
+
+UpdateResult State::layerMapped(LayerToken token, std::string_view layerNamespace) {
+    return m_impl->mapped(token, layerNamespace);
+}
+
+UpdateResult State::layerUnmapped(LayerToken token) {
+    return m_impl->unmapped(token);
+}
+
+std::optional<Lookup> State::lookup(LayerToken token) const {
+    const auto binding = m_impl->binding(token);
+    if (!binding)
+        return std::nullopt;
+    return Lookup(binding->owner, binding->surfaceIndex);
+}
+
+std::shared_ptr<const Snapshot> State::active() const {
+    return m_impl->active();
+}
+
+} // namespace SemanticGeometry
