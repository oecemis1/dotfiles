+std::unordered_map<SCenteredKey, SCenteredResult, SBitsKeyHash> g_centeredCache;
+std::unordered_map<SProfileKey, bool, SBitsKeyHash> g_profileCache;
+std::unordered_map<SPrefixKey, SPrefixResult, SBitsKeyHash> g_prefixCache;
+std::unordered_map<SCombinedKey, SCombinedResult, SBitsKeyHash> g_combinedCache;
+std::unordered_map<SGridTopologyKey, std::shared_ptr<const SGridTopology>, SBitsKeyHash> g_gridTopologyCache;
+std::unordered_map<STopologyKey, std::shared_ptr<const STopology>, SBitsKeyHash> g_topologyCache;
+std::unordered_map<SCenteredTopologyKey, std::shared_ptr<const SCenteredTopology>, SBitsKeyHash> g_centeredTopologyCache;
+std::size_t g_completeHits = 0;
+std::size_t g_completeMisses = 0;
+double      g_completeMissMilliseconds = 0.0;
