diff --git a/src/GeometrySocket.cpp b/src/GeometrySocket.cpp
new file mode 100644
index 0000000..30437da
--- /dev/null
+++ b/src/GeometrySocket.cpp
@@ -0,0 +1,552 @@
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE
+#endif
+
+#include "GeometrySocket.hpp"
+
+#include <wayland-server-core.h>
+
+#include <algorithm>
+#include <array>
+#include <cerrno>
+#include <cstddef>
+#include <cstdlib>
+#include <cstring>
+#include <exception>
+#include <optional>
+#include <string>
+#include <system_error>
+#include <utility>
+
+#include <fcntl.h>
+#include <sys/file.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+namespace {
+
+inline constexpr mode_t DIRECTORY_MODE = 0700;
+inline constexpr mode_t FILE_MODE = 0600;
+inline constexpr std::size_t READ_BUDGET_BYTES = 64 * 1024;
+inline constexpr std::size_t MAX_ACCEPTS_PER_CALLBACK = 64;
+
+static_assert(READ_BUDGET_BYTES == SemanticGeometry::MAX_TRANSACTION_BYTES);
+
+class UniqueFd {
+  public:
+    explicit UniqueFd(int descriptor = -1) : m_descriptor(descriptor) {}
+    ~UniqueFd() {
+        if (m_descriptor >= 0)
+            static_cast<void>(::close(m_descriptor));
+    }
+
+    UniqueFd(const UniqueFd&) = delete;
+    UniqueFd& operator=(const UniqueFd&) = delete;
+
+    [[nodiscard]] int get() const { return m_descriptor; }
+    [[nodiscard]] int release() { return std::exchange(m_descriptor, -1); }
+
+  private:
+    int m_descriptor;
+};
+
+template <typename Operation>
+[[nodiscard]] auto retryOnEintr(Operation&& operation) {
+    decltype(operation()) result;
+    do {
+        result = operation();
+    } while (result == -1 && errno == EINTR);
+    return result;
+}
+
+[[nodiscard]] std::string systemError(std::string_view operation, int error) {
+    std::string message(operation);
+    message += ": ";
+    message += std::error_code(error, std::generic_category()).message();
+    return message;
+}
+
+[[nodiscard]] bool safeComponent(std::string_view component) {
+    if (component.empty() || component == "." || component == "..")
+        return false;
+    for (const char character : component) {
+        const bool allowed = (character >= 'A' && character <= 'Z') ||
+            (character >= 'a' && character <= 'z') ||
+            (character >= '0' && character <= '9') ||
+            character == '.' || character == '_' || character == ':' || character == '-';
+        if (!allowed)
+            return false;
+    }
+    return true;
+}
+
+[[nodiscard]] mode_t permissions(mode_t mode) {
+    return mode & 07777;
+}
+
+[[nodiscard]] bool sameNode(const struct stat& left, const struct stat& right) {
+    return left.st_dev == right.st_dev && left.st_ino == right.st_ino;
+}
+
+[[nodiscard]] sockaddr_un unixAddress(const std::string& path) {
+    sockaddr_un address{};
+    address.sun_family = AF_UNIX;
+    std::memcpy(address.sun_path, path.c_str(), path.size() + 1);
+    return address;
+}
+
+[[nodiscard]] socklen_t unixAddressLength(const std::string& path) {
+    return static_cast<socklen_t>(offsetof(sockaddr_un, sun_path) + path.size() + 1);
+}
+
+[[nodiscard]] int createNonblockingSocket() {
+    return retryOnEintr([] {
+        return ::socket(AF_UNIX, SOCK_STREAM | SOCK_NONBLOCK | SOCK_CLOEXEC, 0);
+    });
+}
+
+} // namespace
+
+class GeometrySocket::Impl {
+  public:
+    Impl(wl_event_loop* eventLoop, std::string runtimeDirectory, std::string instanceSignature,
+         uid_t expectedUid, SemanticGeometry::State& state, Callbacks callbacks) :
+        m_eventLoop(eventLoop), m_runtimeDirectory(std::move(runtimeDirectory)),
+        m_instanceSignature(std::move(instanceSignature)), m_expectedUid(expectedUid),
+        m_state(state), m_callbacks(std::move(callbacks)) {}
+
+    ~Impl() {
+        teardown();
+    }
+
+    [[nodiscard]] std::optional<std::string> start() {
+        if (m_eventLoop == nullptr)
+            return "geometry socket requires a Wayland event loop";
+        if (m_runtimeDirectory.empty())
+            return "geometry socket runtime directory is empty";
+        if (m_runtimeDirectory.front() != '/')
+            return "geometry socket runtime directory must be absolute";
+        if (m_runtimeDirectory.find('\0') != std::string::npos)
+            return "geometry socket runtime directory contains a NUL byte";
+        if (!safeComponent(m_instanceSignature))
+            return "unsafe Hyprland instance signature";
+
+        while (m_runtimeDirectory.size() > 1 && m_runtimeDirectory.back() == '/')
+            m_runtimeDirectory.pop_back();
+        m_directoryPath = m_runtimeDirectory == "/" ? "/hyprglass" : m_runtimeDirectory + "/hyprglass";
+        m_socketPath = m_directoryPath + '/' + m_instanceSignature + ".sock";
+        m_lockPath = m_socketPath + ".lock";
+        if (m_socketPath.size() >= sizeof(sockaddr_un{}.sun_path))
+            return "geometry socket path exceeds AF_UNIX sun_path capacity";
+
+        if (auto error = ensureDirectory())
+            return error;
+        if (auto error = acquireLock())
+            return error;
+        if (auto error = prepareSocketPath())
+            return error;
+        if (auto error = createListener())
+            return error;
+
+        m_running = true;
+        return std::nullopt;
+    }
+
+    [[nodiscard]] std::string_view socketPath() const noexcept {
+        return m_socketPath;
+    }
+
+    [[nodiscard]] std::string_view lockPath() const noexcept {
+        return m_lockPath;
+    }
+
+    [[nodiscard]] bool running() const noexcept {
+        return m_running;
+    }
+
+  private:
+    [[nodiscard]] std::optional<std::string> ensureDirectory() {
+        if (retryOnEintr([this] { return ::mkdir(m_directoryPath.c_str(), DIRECTORY_MODE); }) == -1 && errno != EEXIST)
+            return systemError("cannot create geometry socket directory", errno);
+
+        UniqueFd directory(retryOnEintr([this] {
+            return ::open(m_directoryPath.c_str(), O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW);
+        }));
+        if (directory.get() < 0)
+            return systemError("cannot open geometry socket directory", errno);
+
+        struct stat status {};
+        if (retryOnEintr([&] { return ::fstat(directory.get(), &status); }) == -1)
+            return systemError("cannot inspect geometry socket directory", errno);
+        if (!S_ISDIR(status.st_mode))
+            return "geometry socket directory is not a directory";
+        if (status.st_uid != ::geteuid())
+            return "geometry socket directory is not owned by the effective user";
+        if (retryOnEintr([&] { return ::fchmod(directory.get(), DIRECTORY_MODE); }) == -1)
+            return systemError("cannot secure geometry socket directory", errno);
+        if (retryOnEintr([&] { return ::fstat(directory.get(), &status); }) == -1)
+            return systemError("cannot verify geometry socket directory", errno);
+        if (status.st_uid != ::geteuid() || permissions(status.st_mode) != DIRECTORY_MODE)
+            return "geometry socket directory does not have owner mode 0700";
+        return std::nullopt;
+    }
+
+    [[nodiscard]] std::optional<std::string> acquireLock() {
+        UniqueFd lock(retryOnEintr([this] {
+            return ::open(m_lockPath.c_str(), O_RDWR | O_CREAT | O_CLOEXEC | O_NOFOLLOW, FILE_MODE);
+        }));
+        if (lock.get() < 0)
+            return systemError("cannot open geometry server lock", errno);
+
+        struct stat status {};
+        if (retryOnEintr([&] { return ::fstat(lock.get(), &status); }) == -1)
+            return systemError("cannot inspect geometry server lock", errno);
+        if (!S_ISREG(status.st_mode))
+            return "geometry server lock is not a regular file";
+        if (status.st_uid != ::geteuid())
+            return "geometry server lock is not owned by the effective user";
+
+        if (retryOnEintr([&] { return ::flock(lock.get(), LOCK_EX | LOCK_NB); }) == -1) {
+            const int error = errno;
+            if (error == EWOULDBLOCK || error == EAGAIN)
+                return "geometry server lock is already held";
+            return systemError("cannot acquire geometry server lock", error);
+        }
+        if (retryOnEintr([&] { return ::fchmod(lock.get(), FILE_MODE); }) == -1)
+            return systemError("cannot secure geometry server lock", errno);
+        if (retryOnEintr([&] { return ::fstat(lock.get(), &status); }) == -1)
+            return systemError("cannot verify geometry server lock", errno);
+        if (!S_ISREG(status.st_mode) || status.st_uid != ::geteuid() || permissions(status.st_mode) != FILE_MODE)
+            return "geometry server lock does not have owner mode 0600";
+
+        m_lockFd = lock.release();
+        return std::nullopt;
+    }
+
+    [[nodiscard]] std::optional<std::string> prepareSocketPath() {
+        struct stat existing {};
+        if (retryOnEintr([this, &existing] { return ::lstat(m_socketPath.c_str(), &existing); }) == -1) {
+            if (errno == ENOENT)
+                return std::nullopt;
+            return systemError("cannot inspect existing geometry socket path", errno);
+        }
+        if (!S_ISSOCK(existing.st_mode))
+            return "existing geometry socket path is not a socket";
+
+        UniqueFd probe(createNonblockingSocket());
+        if (probe.get() < 0)
+            return systemError("cannot create geometry socket probe", errno);
+        const sockaddr_un address = unixAddress(m_socketPath);
+        if (::connect(probe.get(), reinterpret_cast<const sockaddr*>(&address), unixAddressLength(m_socketPath)) == 0)
+            return "an active geometry server already owns the socket path";
+
+        const int connectError = errno;
+        if (connectError != ECONNREFUSED)
+            return systemError("existing geometry socket probe was inconclusive", connectError);
+
+        struct stat current {};
+        if (retryOnEintr([this, &current] { return ::lstat(m_socketPath.c_str(), &current); }) == -1)
+            return systemError("cannot recheck refused geometry socket", errno);
+        if (!S_ISSOCK(current.st_mode) || !sameNode(existing, current))
+            return "refused geometry socket path changed during probing";
+        if (retryOnEintr([this] { return ::unlink(m_socketPath.c_str()); }) == -1)
+            return systemError("cannot remove refused geometry socket", errno);
+        return std::nullopt;
+    }
+
+    [[nodiscard]] std::optional<std::string> createListener() {
+        m_listenerFd = createNonblockingSocket();
+        if (m_listenerFd < 0)
+            return systemError("cannot create geometry listener", errno);
+
+        const sockaddr_un address = unixAddress(m_socketPath);
+        if (retryOnEintr([&] {
+                return ::bind(m_listenerFd, reinterpret_cast<const sockaddr*>(&address), unixAddressLength(m_socketPath));
+            }) == -1)
+            return systemError("cannot bind geometry listener", errno);
+
+        struct stat created {};
+        if (retryOnEintr([this, &created] { return ::lstat(m_socketPath.c_str(), &created); }) == -1)
+            return systemError("cannot inspect created geometry socket", errno);
+        if (!S_ISSOCK(created.st_mode) || created.st_uid != ::geteuid())
+            return "created geometry socket has an unexpected type or owner";
+        m_socketDevice = created.st_dev;
+        m_socketInode = created.st_ino;
+        m_ownsSocketPath = true;
+
+        if (retryOnEintr([this] { return ::chmod(m_socketPath.c_str(), FILE_MODE); }) == -1)
+            return systemError("cannot secure geometry socket", errno);
+        struct stat secured {};
+        if (retryOnEintr([this, &secured] { return ::lstat(m_socketPath.c_str(), &secured); }) == -1)
+            return systemError("cannot verify geometry socket", errno);
+        if (!S_ISSOCK(secured.st_mode) || secured.st_uid != ::geteuid() ||
+            secured.st_dev != m_socketDevice || secured.st_ino != m_socketInode || permissions(secured.st_mode) != FILE_MODE)
+            return "geometry socket does not have the expected owner, inode, and mode 0600";
+
+        if (retryOnEintr([this] { return ::listen(m_listenerFd, 8); }) == -1)
+            return systemError("cannot listen on geometry socket", errno);
+        m_listenerSource = wl_event_loop_add_fd(
+            m_eventLoop, m_listenerFd, WL_EVENT_READABLE, &Impl::listenerDispatch, this);
+        if (m_listenerSource == nullptr)
+            return "cannot register geometry listener with the Wayland event loop";
+        return std::nullopt;
+    }
+
+    static int listenerDispatch(int descriptor, std::uint32_t mask, void* data) {
+        auto* self = static_cast<Impl*>(data);
+        try {
+            self->handleListener(descriptor, mask);
+        } catch (...) {
+            self->failRuntime("unexpected exception in geometry listener callback");
+        }
+        return 0;
+    }
+
+    static int clientDispatch(int descriptor, std::uint32_t mask, void* data) {
+        auto* self = static_cast<Impl*>(data);
+        try {
+            self->handleClient(descriptor, mask);
+        } catch (...) {
+            self->failRuntime("unexpected exception in geometry client callback");
+        }
+        return 0;
+    }
+
+    void handleListener(int descriptor, std::uint32_t mask) {
+        if (!m_running)
+            return;
+        if (descriptor != m_listenerFd) {
+            failRuntime("geometry listener callback reported an unexpected descriptor");
+            return;
+        }
+        if ((mask & (WL_EVENT_HANGUP | WL_EVENT_ERROR)) != 0U) {
+            failRuntime("geometry listener reported a fatal event-loop condition");
+            return;
+        }
+        if ((mask & WL_EVENT_READABLE) == 0U)
+            return;
+
+        for (std::size_t attempts = 0; attempts < MAX_ACCEPTS_PER_CALLBACK;) {
+            const int accepted = ::accept4(m_listenerFd, nullptr, nullptr, SOCK_NONBLOCK | SOCK_CLOEXEC);
+            if (accepted < 0) {
+                const int error = errno;
+                if (error == EINTR)
+                    continue;
+                if (error == EAGAIN || error == EWOULDBLOCK)
+                    return;
+                if (error == ECONNABORTED || error == EPROTO) {
+                    ++attempts;
+                    continue;
+                }
+                const std::string message = systemError("geometry listener accept failed", error);
+                failRuntime(message);
+                return;
+            }
+            ++attempts;
+            UniqueFd peer(accepted);
+
+            struct ucred credentials {};
+            socklen_t credentialsSize = sizeof(credentials);
+            if (retryOnEintr([&] {
+                    return ::getsockopt(peer.get(), SOL_SOCKET, SO_PEERCRED, &credentials, &credentialsSize);
+                }) == -1 || credentialsSize != sizeof(credentials) || credentials.uid != m_expectedUid)
+                continue;
+            if (m_clientFd >= 0)
+                continue;
+
+            wl_event_source* source = wl_event_loop_add_fd(
+                m_eventLoop, peer.get(), WL_EVENT_READABLE, &Impl::clientDispatch, this);
+            if (source == nullptr) {
+                failRuntime("cannot register geometry client with the Wayland event loop");
+                return;
+            }
+            m_clientFd = peer.release();
+            m_clientSource = source;
+            m_stateConnected = true;
+            deliver(m_state.clientConnected());
+        }
+    }
+
+    void handleClient(int descriptor, std::uint32_t mask) {
+        if (!m_running || descriptor != m_clientFd)
+            return;
+
+        std::array<char, 8192> buffer{};
+        std::size_t remaining = READ_BUDGET_BYTES;
+        bool wouldBlock = false;
+        while (remaining > 0) {
+            const std::size_t request = std::min(remaining, buffer.size());
+            const ssize_t received = ::read(m_clientFd, buffer.data(), request);
+            if (received > 0) {
+                const auto count = static_cast<std::size_t>(received);
+                remaining -= count;
+                deliver(m_state.ingest(std::string_view(buffer.data(), count)));
+                continue;
+            }
+            if (received == 0) {
+                disconnectClient();
+                return;
+            }
