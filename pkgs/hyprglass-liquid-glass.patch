+std::expected<SOpticalConfigOverrides, SOpticalConfigError> mergeOpticalConfigOverrides(
+    const SOpticalConfigOverrides& base, const SOpticalConfigOverrides& overrides) {
+    const bool baseHasFlatRim = base.legacyFresnelStrength || base.legacySpecularStrength;
+    const bool overrideHasFlatRim = overrides.legacyFresnelStrength || overrides.legacySpecularStrength;
+    const bool baseHasFlatSnell = base.snellBezelWidth.has_value();
+    const bool overrideHasFlatSnell = overrides.snellBezelWidth.has_value();
+    if ((base.rim && baseHasFlatRim) || (overrides.rim && overrideHasFlatRim) ||
+        (base.rim && overrideHasFlatRim) || (overrides.rim && baseHasFlatRim))
+        return std::unexpected(rimConflictError());
+    if ((base.snell && baseHasFlatSnell) || (overrides.snell && overrideHasFlatSnell) ||
+        (base.snell && overrideHasFlatSnell) || (overrides.snell && baseHasFlatSnell))
+        return std::unexpected(snellConflictError());
+
+    SOpticalConfigOverrides result = base;
+    const auto replace = [](auto& target, const auto& value) {
+        if (value)
+            target = value;
+    };
+    replace(result.shapePower, overrides.shapePower);
+    replace(result.refractionCurve, overrides.refractionCurve);
+    replace(result.centeredMappingStrength, overrides.centeredMappingStrength);
+    replace(result.noiseStrength, overrides.noiseStrength);
+    replace(result.chromaticAberration, overrides.chromaticAberration);
+    replace(result.glow, overrides.glow);
+    replace(result.blurRadius, overrides.blurRadius);
+    replace(result.blurIterations, overrides.blurIterations);
+    replace(result.snell, overrides.snell);
+    replace(result.snellBezelWidth, overrides.snellBezelWidth);
+    replace(result.rim, overrides.rim);
+    replace(result.legacyFresnelStrength, overrides.legacyFresnelStrength);
+    replace(result.legacySpecularStrength, overrides.legacySpecularStrength);
+    return result;
+}
+
+std::expected<SOpticalConfig, SOpticalConfigError> applyOpticalConfigOverrides(
+    const SOpticalConfig& base, const SOpticalConfigOverrides& overrides) {
+    const bool hasFlatRim = overrides.legacyFresnelStrength || overrides.legacySpecularStrength;
+    if (overrides.rim && hasFlatRim)
+        return std::unexpected(rimConflictError());
+    if (overrides.snell && overrides.snellBezelWidth)
+        return std::unexpected(snellConflictError());
+
+    auto input = base.input();
+    if (overrides.shapePower)
+        input.shapePower = *overrides.shapePower;
+    if (overrides.refractionCurve)
+        input.refractionCurve = overrides.refractionCurve->input();
+    if (overrides.centeredMappingStrength)
+        input.centeredMappingStrength = *overrides.centeredMappingStrength;
+    if (overrides.noiseStrength)
+        input.noiseStrength = *overrides.noiseStrength;
+    if (overrides.chromaticAberration)
+        input.chromaticAberration = *overrides.chromaticAberration;
+    if (overrides.glow)
+        input.glow = overrides.glow->input();
+    if (overrides.blurRadius)
+        input.blurRadius = *overrides.blurRadius;
+    if (overrides.blurIterations)
+        input.blurIterations = *overrides.blurIterations;
+    if (overrides.snell)
+        input.snell = overrides.snell->input();
+    if (overrides.snellBezelWidth)
+        input.snell.widthPx = *overrides.snellBezelWidth;
+    if (overrides.rim) {
+        input.rim = overrides.rim->input();
+    } else if (hasFlatRim) {
+        input.rim = {
+            .widthPx = 2.0,
+            .saturation = 1.0,
+            .fresnelStrength = overrides.legacyFresnelStrength.value_or(base.rim().fresnelStrength()),
+            .specularStrength = overrides.legacySpecularStrength.value_or(base.rim().specularStrength()),
+            .innerShadowStrength = 0.0,
+            .angleRadians = 2.0 * std::numbers::pi / 3.0,
+        };
+    }
+    return SOpticalConfig::from(input);
+}
