index 0000000..0a1897f
--- /dev/null
+++ b/src/BlurVariantPlan.hpp
@@ -0,0 +1,40 @@
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <expected>
+#include <span>
+#include <vector>
+
+namespace BlurVariantPlan {
+
+inline constexpr std::size_t MAX_VARIANTS = 3;
+
+enum class EPlanError : uint8_t {
+    INVALID_RADIUS,
+    TOO_MANY_VARIANTS,
+};
+
+[[nodiscard]] inline std::expected<std::vector<float>, EPlanError> make(
+    float baseRadius, std::span<const float> requestedRadii) {
+    if (!std::isfinite(baseRadius) || baseRadius < 0.0f)
+        return std::unexpected(EPlanError::INVALID_RADIUS);
+
+    std::vector<float> variants;
+    variants.reserve(std::min(requestedRadii.size(), MAX_VARIANTS));
+    for (const float radius : requestedRadii) {
+        if (!std::isfinite(radius))
+            return std::unexpected(EPlanError::INVALID_RADIUS);
+        if (radius < 0.0f || radius == baseRadius ||
+            std::find(variants.begin(), variants.end(), radius) != variants.end())
+            continue;
+        if (variants.size() == MAX_VARIANTS)
+            return std::unexpected(EPlanError::TOO_MANY_VARIANTS);
+        variants.push_back(radius);
+    }
+    return variants;
+}
+
+} // namespace BlurVariantPlan
