+    [[nodiscard]] constexpr double b() const { return m_b; }
+    [[nodiscard]] constexpr double c() const { return m_c; }
+    [[nodiscard]] constexpr double d() const { return m_d; }
+    [[nodiscard]] constexpr double power() const { return m_power; }
+    [[nodiscard]] constexpr SRefractionCurveInput input() const { return {m_a, m_b, m_c, m_d, m_power}; }
+
+    [[nodiscard]] friend constexpr bool operator==(const SRefractionCurve&, const SRefractionCurve&) = default;
+
+  private:
+    constexpr SRefractionCurve(double a, double b, double c, double d, double power) :
+        m_a(a), m_b(b), m_c(c), m_d(d), m_power(power) {}
+
+    double m_a;
+    double m_b;
+    double m_c;
+    double m_d;
+    double m_power;
+
+    friend class SOpticalConfig;
+};
+
+struct SAngularGlowInput {
