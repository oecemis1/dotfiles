+        if (remaining != 0 && wouldBlock && (mask & (WL_EVENT_HANGUP | WL_EVENT_ERROR)) != 0U)
+            disconnectClient();
+    }
+
+    void deliver(SemanticGeometry::UpdateResult result) {
+        if (!result.empty() && m_callbacks.update)
+            m_callbacks.update(std::move(result));
+    }
+
+    void disconnectClient() {
+        if (m_clientSource != nullptr) {
+            wl_event_source* source = std::exchange(m_clientSource, nullptr);
+            static_cast<void>(wl_event_source_remove(source));
+        }
+        if (m_clientFd >= 0) {
+            const int descriptor = std::exchange(m_clientFd, -1);
+            static_cast<void>(::close(descriptor));
+        }
+        if (!m_stateConnected)
+            return;
+        m_stateConnected = false;
+        deliver(m_state.clientDisconnected());
+    }
+
+    void stopListener() noexcept {
+        m_running = false;
+        if (m_listenerSource != nullptr) {
+            wl_event_source* source = std::exchange(m_listenerSource, nullptr);
+            static_cast<void>(wl_event_source_remove(source));
+        }
+        if (m_listenerFd >= 0) {
+            const int descriptor = std::exchange(m_listenerFd, -1);
+            static_cast<void>(::close(descriptor));
+        }
+    }
+
+    void unlinkOwnedSocket() noexcept {
+        if (!m_ownsSocketPath)
+            return;
+        struct stat current {};
+        if (retryOnEintr([this, &current] { return ::lstat(m_socketPath.c_str(), &current); }) == -1) {
+            if (errno == ENOENT)
+                m_ownsSocketPath = false;
+            return;
+        }
+        if (!S_ISSOCK(current.st_mode) || current.st_dev != m_socketDevice || current.st_ino != m_socketInode) {
+            m_ownsSocketPath = false;
+            return;
+        }
+        if (retryOnEintr([this] { return ::unlink(m_socketPath.c_str()); }) == 0)
+            m_ownsSocketPath = false;
+    }
+
+    void failRuntime(std::string_view message) noexcept {
+        if (m_runtimeFailureSent)
+            return;
+        m_runtimeFailureSent = true;
+        stopListener();
+        try {
+            disconnectClient();
+        } catch (...) {
+        }
+        unlinkOwnedSocket();
+        if (m_callbacks.runtimeFailure) {
+            try {
+                m_callbacks.runtimeFailure(message);
+            } catch (...) {
+            }
+        }
+    }
+
+    void teardown() noexcept {
+        stopListener();
+        try {
+            disconnectClient();
+        } catch (...) {
+        }
+        unlinkOwnedSocket();
+        if (m_lockFd >= 0) {
+            const int descriptor = std::exchange(m_lockFd, -1);
+            static_cast<void>(::close(descriptor));
+        }
+    }
+
+    wl_event_loop*                  m_eventLoop = nullptr;
+    std::string                     m_runtimeDirectory;
+    std::string                     m_instanceSignature;
+    uid_t                           m_expectedUid;
+    SemanticGeometry::State&        m_state;
+    Callbacks                       m_callbacks;
+    std::string                     m_directoryPath;
+    std::string                     m_socketPath;
+    std::string                     m_lockPath;
+    int                             m_lockFd = -1;
+    int                             m_listenerFd = -1;
+    int                             m_clientFd = -1;
+    wl_event_source*                m_listenerSource = nullptr;
+    wl_event_source*                m_clientSource = nullptr;
+    dev_t                           m_socketDevice = 0;
+    ino_t                           m_socketInode = 0;
+    bool                            m_ownsSocketPath = false;
+    bool                            m_stateConnected = false;
+    bool                            m_running = false;
+    bool                            m_runtimeFailureSent = false;
+};
+
+GeometrySocket::GeometrySocket(std::unique_ptr<Impl> impl) : m_impl(std::move(impl)) {}
+
+GeometrySocket::~GeometrySocket() = default;
+
+std::expected<std::unique_ptr<GeometrySocket>, std::string> GeometrySocket::create(
+    wl_event_loop* eventLoop, std::string_view runtimeDirectory, std::string_view instanceSignature,
+    uid_t expectedUid, SemanticGeometry::State& state, Callbacks callbacks) {
+    try {
+        auto impl = std::make_unique<Impl>(
+            eventLoop, std::string(runtimeDirectory), std::string(instanceSignature), expectedUid, state,
+            std::move(callbacks));
+        if (auto error = impl->start())
+            return std::unexpected(std::move(*error));
+        return std::unique_ptr<GeometrySocket>(new GeometrySocket(std::move(impl)));
+    } catch (const std::exception& exception) {
+        return std::unexpected(std::string("geometry socket startup failed: ") + exception.what());
+    } catch (...) {
+        return std::unexpected("geometry socket startup failed with an unknown exception");
+    }
+}
+
+std::expected<std::unique_ptr<GeometrySocket>, std::string> GeometrySocket::createFromEnvironment(
+    wl_event_loop* eventLoop, SemanticGeometry::State& state, Callbacks callbacks) {
+    const char* runtimeDirectory = std::getenv("XDG_RUNTIME_DIR");
+    if (runtimeDirectory == nullptr || runtimeDirectory[0] == '\0')
+        return std::unexpected("XDG_RUNTIME_DIR is not set");
+    const char* instanceSignature = std::getenv("HYPRLAND_INSTANCE_SIGNATURE");
+    if (instanceSignature == nullptr || instanceSignature[0] == '\0')
+        return std::unexpected("HYPRLAND_INSTANCE_SIGNATURE is not set");
+    return create(eventLoop, runtimeDirectory, instanceSignature, ::geteuid(), state, std::move(callbacks));
+}
+
+std::string_view GeometrySocket::socketPath() const noexcept {
+    return m_impl->socketPath();
+}
+
+std::string_view GeometrySocket::lockPath() const noexcept {
+    return m_impl->lockPath();
+}
+
+bool GeometrySocket::running() const noexcept {
+    return m_impl->running();
+}
