         lua_pop(L, 1);
+        static_assert(std::numeric_limits<lua_Integer>::digits <= std::numeric_limits<int64_t>::digits);
+        if (!conversionSucceeded)
+            return std::unexpected(SPresetDiagnostic{std::string(preset), fieldPath(field), "must be a finite integer"});
+        if (auto parsed = setPresetIntegerField(values, preset, field, static_cast<int64_t>(number)); !parsed) {
+            prefixPresetPath(parsed.error(), layerPath);
+            return parsed;
+        }
+    }
+
+    if (auto parsed = readRefractionCurve(L, tableIndex, preset, values); !parsed) {
+        prefixPresetPath(parsed.error(), layerPath);
+        return parsed;
     }
+    if (auto parsed = readGlow(L, tableIndex, preset, values); !parsed) {
+        prefixPresetPath(parsed.error(), layerPath);
+        return parsed;
+    }
+    if (auto parsed = readSnell(L, tableIndex, preset, values); !parsed) {
+        prefixPresetPath(parsed.error(), layerPath);
+        return parsed;
+    }
+    auto rim = readRim(L, tableIndex, preset, values);
+    if (!rim)
+        prefixPresetPath(rim.error(), layerPath);
+    return rim;
