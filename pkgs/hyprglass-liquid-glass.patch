+std::expected<SOpticalConfig, SOpticalConfigError> SOpticalConfig::from(const SOpticalConfigInput& input) {
+    const auto rendered = shaderValues(input);
+    const auto validation = validateComplete(rendered);
+    if (validation.error)
+        return std::unexpected(*validation.error);
+
+    const auto curve = SRefractionCurve::from(rendered.refractionCurve);
+    const auto glow = SAngularGlow::from(rendered.glow);
+    const auto snell = SConvexBezel::from(rendered.snell);
+    const auto rim = SRimMaterial::from(rendered.rim);
+    if (!curve)
+        return std::unexpected(curve.error());
+    if (!glow)
+        return std::unexpected(glow.error());
+    if (!snell)
+        return std::unexpected(snell.error());
+    if (!rim)
+        return std::unexpected(rim.error());
+
+    return SOpticalConfig{
+        rendered.shapePower, *curve, rendered.centeredMappingStrength, rendered.noiseStrength,
+        rendered.chromaticAberration, *glow, rendered.blurRadius, static_cast<int>(rendered.blurIterations),
+        *snell, *rim, validation.diagnostics};
+}
