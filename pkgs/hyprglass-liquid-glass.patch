+        }
+        if (lua_type(L, -1) != LUA_TNUMBER) {
+            lua_pop(L, 1);
+            return std::unexpected(SPresetDiagnostic{std::string(preset), fieldPath(field), "must be a number"});
+        }
+        const double number = lua_tonumber(L, -1);
+        lua_pop(L, 1);
+        if (auto parsed = setPresetNumberField(values, preset, field, number); !parsed) {
+            prefixPresetPath(parsed.error(), layerPath);
