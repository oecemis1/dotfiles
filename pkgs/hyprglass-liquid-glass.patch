+[[nodiscard]] std::expected<SPresetConfigSnapshot, SPresetConfigError> buildPresetConfigSnapshot(
+    TPresetMap builtIns, const TPresetMap& pending, const SOpticalConfigLayerOverrides& layers);
+
+class SPresetRegistry {
+  public:
