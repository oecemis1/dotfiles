+namespace SemanticGeometry {
+
+using LayerToken = std::uintptr_t;
+
+inline constexpr std::size_t MAX_SURFACES = 4;
+inline constexpr std::size_t MAX_SHAPES = 16;
+inline constexpr std::size_t MAX_CLIPS = 16;
+inline constexpr std::size_t MAX_RECORD_BYTES = 8 * 1024;
+inline constexpr std::size_t MAX_TRANSACTION_BYTES = 64 * 1024;
+inline constexpr std::size_t MAX_TRACKED_EPOCHS = 256;
+
+struct Rect {
+    float x;
+    float y;
+    float width;
+    float height;
+
+    [[nodiscard]] constexpr float right() const { return x + width; }
+    [[nodiscard]] constexpr float bottom() const { return y + height; }
+    [[nodiscard]] constexpr float centerX() const { return x + width * 0.5F; }
+    [[nodiscard]] constexpr float centerY() const { return y + height * 0.5F; }
+
+    [[nodiscard]] friend constexpr bool operator==(const Rect&, const Rect&) = default;
+};
+
+enum class Role : std::uint8_t {
+    SHEET,
+    CONTROL,
+};
+
+class SnapshotBuilder;
+
+class Clip {
+  public:
