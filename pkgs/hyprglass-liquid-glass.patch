+    void reject(SPresetConfigError error);
+    [[nodiscard]] std::expected<void, SPresetConfigError> stage(const SCustomPreset& patch);
+    [[nodiscard]] std::expected<std::reference_wrapper<const SPresetConfigSnapshot>, SPresetConfigError> initialize(
+        TPresetMap builtIns, const SOpticalConfigLayerOverrides& layers);
+    [[nodiscard]] std::expected<std::reference_wrapper<const SPresetConfigSnapshot>, SPresetConfigError> commit(
+        TPresetMap builtIns, const SOpticalConfigLayerOverrides& layers);
+    [[nodiscard]] std::expected<std::reference_wrapper<const SPresetConfigSnapshot>, SPresetConfigError> refreshLayers(
+        const SOpticalConfigLayerOverrides& layers);
+
+    [[nodiscard]] const SPresetConfigSnapshot* active() const;
+    [[nodiscard]] uint64_t generation() const { return m_generation; }
+    [[nodiscard]] bool transactionFailed() const { return m_firstFailure.has_value(); }
+    [[nodiscard]] const TPresetMap& pending() const { return m_pending; }
