+struct SVec2 {
+    double x;
+    double y;
+};
+
+[[nodiscard]] constexpr SVec2 operator+(SVec2 left, SVec2 right) {
+    return {left.x + right.x, left.y + right.y};
+}
+
+[[nodiscard]] constexpr SVec2 operator-(SVec2 left, SVec2 right) {
+    return {left.x - right.x, left.y - right.y};
+}
+
+[[nodiscard]] constexpr SVec2 operator*(SVec2 value, double scale) {
+    return {value.x * scale, value.y * scale};
+}
+
+[[nodiscard]] constexpr double mix(double left, double right, double amount) {
+    return left + (right - left) * amount;
+}
+
+[[nodiscard]] double smoothstep(double edge0, double edge1, double value) {
+    const double amount = std::clamp((value - edge0) / (edge1 - edge0), 0.0, 1.0);
+    return amount * amount * (3.0 - 2.0 * amount);
+}
+
+[[nodiscard]] double curveBase(double distance, const SRefractionCurveInput& curve) {
+    return 1.0 - curve.b * std::pow(curve.c * std::numbers::e, -curve.d * distance - curve.a);
+}
+
+[[nodiscard]] double curveScale(double distance, const SRefractionCurveInput& curve) {
+    return std::pow(curveBase(distance, curve), curve.power);
+}
