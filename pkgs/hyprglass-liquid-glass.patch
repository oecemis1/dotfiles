+
+static void damageSemanticRect(PHLLS layerSurface, PHLMONITOR monitor, const SemanticGeometry::Rect& localBounds) {
+    if (!layerSurface || !monitor || !g_pHyprRenderer || !std::isfinite(monitor->m_scale) || monitor->m_scale <= 0.0F)
+        return;
+
+    const auto position = layerSurface->position(Desktop::View::IGeometric::GEOMETRIC_CURRENT);
+    const auto size = layerSurface->size(Desktop::View::IGeometric::GEOMETRIC_CURRENT);
+    if (!std::isfinite(position.x) || !std::isfinite(position.y) ||
+        !std::isfinite(size.x) || !std::isfinite(size.y) || size.x <= 0.0 || size.y <= 0.0)
+        return;
+
+    const double left = std::max(0.0, static_cast<double>(localBounds.x));
+    const double top = std::max(0.0, static_cast<double>(localBounds.y));
+    const double right = std::min(size.x, static_cast<double>(localBounds.right()));
+    const double bottom = std::min(size.y, static_cast<double>(localBounds.bottom()));
+    if (right <= left || bottom <= top)
+        return;
+
+    CBox damage{position.x + left, position.y + top, right - left, bottom - top};
+    damage.expand(GlassRenderer::SAMPLE_PADDING_PX / monitor->m_scale).noNegativeSize();
+    if (std::isfinite(damage.x) && std::isfinite(damage.y) && std::isfinite(damage.w) && std::isfinite(damage.h) &&
+        damage.w > 0.0 && damage.h > 0.0)
+        g_pHyprRenderer->damageBox(damage);
+}
+
+static void applySemanticGeometryUpdate(SemanticGeometry::UpdateResult result) {
+    if (!g_pGlobalState)
+        return;
+
+    for (const auto& effect : result.layerEffects) {
+        const auto mapped = g_pGlobalState->semanticLayerSurfaces.find(effect.layer);
+        if (mapped == g_pGlobalState->semanticLayerSurfaces.end())
+            continue;
+        const auto layerSurface = mapped->second.lock();
+        if (!layerSurface)
+            continue;
+        const auto monitor = layerSurface->m_monitor.lock();
+        if (!monitor)
+            continue;
+
+        if (effect.fullLayer) {
+            const auto position = layerSurface->position(Desktop::View::IGeometric::GEOMETRIC_CURRENT);
+            const auto size = layerSurface->size(Desktop::View::IGeometric::GEOMETRIC_CURRENT);
+            if (!std::isfinite(position.x) || !std::isfinite(position.y) ||
+                !std::isfinite(size.x) || !std::isfinite(size.y) || size.x <= 0.0 || size.y <= 0.0 ||
+                !std::isfinite(monitor->m_scale) || monitor->m_scale <= 0.0F)
+                continue;
+            CBox damage{position, size};
+            damage.expand(GlassRenderer::SAMPLE_PADDING_PX / monitor->m_scale).noNegativeSize();
+            if (std::isfinite(damage.x) && std::isfinite(damage.y) && std::isfinite(damage.w) && std::isfinite(damage.h) &&
+                damage.w > 0.0 && damage.h > 0.0)
+                g_pHyprRenderer->damageBox(damage);
+            continue;
+        }
+
+        for (const auto& bounds : effect.oldShapeBounds)
+            damageSemanticRect(layerSurface, monitor, bounds);
+        for (const auto& bounds : effect.newShapeBounds)
+            damageSemanticRect(layerSurface, monitor, bounds);
+    }
+}
+
+static void mapSemanticLayer(PHLLS layerSurface) {
+    if (!g_pGlobalState || !layerSurface || !layerSurface->m_mapped)
+        return;
+    const auto token = semanticLayerToken(layerSurface);
+    g_pGlobalState->semanticLayerSurfaces.insert_or_assign(token, PHLLSREF{layerSurface});
+    applySemanticGeometryUpdate(g_pGlobalState->semanticGeometry.layerMapped(token, layerSurface->m_namespace));
+}
+
+static void unmapSemanticLayer(PHLLS layerSurface) {
+    if (!g_pGlobalState || !layerSurface)
+        return;
+    const auto token = semanticLayerToken(layerSurface);
+    applySemanticGeometryUpdate(g_pGlobalState->semanticGeometry.layerUnmapped(token));
+    g_pGlobalState->semanticLayerSurfaces.erase(token);
