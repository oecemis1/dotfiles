diff --git a/src/PresetConfig.cpp b/src/PresetConfig.cpp
new file mode 100644
index 0000000..37f041f
--- /dev/null
+++ b/src/PresetConfig.cpp
@@ -0,0 +1,265 @@
+#include "PresetConfig.hpp"
+
+#include <algorithm>
+#include <utility>
+#include <vector>
+
+namespace {
+
+constexpr int MAX_PRESET_DEPTH = 8;
+
+[[nodiscard]] SPresetConfigError opticalError(std::string_view presetName, const SOpticalConfigError& error) {
+    return {std::string(presetName), error.fieldPath, error.detail};
+}
+
+[[nodiscard]] std::expected<SOpticalConfig, SPresetConfigError> applyPresetOptics(
+    SOpticalConfig resolved, std::string_view presetName, bool isDark, const TPresetMap& presets, int depth) {
+    if (depth >= MAX_PRESET_DEPTH)
+        return resolved;
+    const auto iterator = presets.find(std::string(presetName));
+    if (iterator == presets.end())
+        return resolved;
+
+    const auto& preset = iterator->second;
+    if (!preset.inherits.empty()) {
+        auto inherited = applyPresetOptics(std::move(resolved), preset.inherits, isDark, presets, depth + 1);
+        if (!inherited)
+            return std::unexpected(inherited.error());
+        resolved = std::move(*inherited);
+    }
+
+    auto shared = applyOpticalConfigOverrides(resolved, preset.shared.optics);
+    if (!shared)
+        return std::unexpected(opticalError(presetName, shared.error()));
+    auto themed = applyOpticalConfigOverrides(*shared, (isDark ? preset.dark : preset.light).optics);
+    if (!themed)
+        return std::unexpected(opticalError(presetName, themed.error()));
+    return std::move(*themed);
+}
+
+[[nodiscard]] std::expected<std::pair<SOpticalConfig, SOpticalConfig>, SPresetConfigError> resolveThemeDefaults(
+    const SOpticalConfigLayerOverrides& layers) {
+    auto global = applyOpticalConfigOverrides(defaultOpticalConfig(), layers.global);
+    if (!global)
+        return std::unexpected(opticalError("global", global.error()));
+    auto dark = applyOpticalConfigOverrides(*global, layers.dark);
+    if (!dark)
+        return std::unexpected(opticalError("dark", dark.error()));
+    auto light = applyOpticalConfigOverrides(*global, layers.light);
+    if (!light)
+        return std::unexpected(opticalError("light", light.error()));
+    return std::pair{std::move(*dark), std::move(*light)};
+}
+
+} // namespace
+
+std::string SPresetConfigError::message() const {
+    return "hyprglass.preset '" + preset + "': " + fieldPath + ": " + detail;
+}
+
+SPresetConfigSnapshot::SPresetConfigSnapshot(
+    TPresetMap presets, SOpticalConfig darkDefault, SOpticalConfig lightDefault,
+    std::unordered_map<std::string, SResolvedPresetOptics> resolvedOptics) :
+    m_presets(std::move(presets)), m_darkDefault(std::move(darkDefault)), m_lightDefault(std::move(lightDefault)),
+    m_resolvedOptics(std::move(resolvedOptics)) {}
+
+const SOpticalConfig& SPresetConfigSnapshot::resolve(std::string_view presetName, bool isDark) const {
+    const auto iterator = m_resolvedOptics.find(std::string(presetName));
+    if (iterator == m_resolvedOptics.end())
+        return isDark ? m_darkDefault : m_lightDefault;
+    return isDark ? iterator->second.dark : iterator->second.light;
+}
+
+std::expected<void, SPresetConfigError> mergePresetValues(
+    SPresetValues& target, const SPresetValues& overrides, std::string_view presetName) {
+    auto mergedOptics = mergeOpticalConfigOverrides(target.optics, overrides.optics);
+    if (!mergedOptics)
+        return std::unexpected(opticalError(presetName, mergedOptics.error()));
+
+    SPresetValues merged = target;
+    const auto mergeFloat = [](float& destination, float source) {
+        if (source >= 0.0f)
+            destination = source;
+    };
+    const auto mergeInt = [](int64_t& destination, int64_t source) {
+        if (source >= 0)
+            destination = source;
+    };
+
+    mergeFloat(merged.blurStrength, overrides.blurStrength);
+    mergeInt(merged.blurIterations, overrides.blurIterations);
+    mergeFloat(merged.refractionStrength, overrides.refractionStrength);
+    mergeFloat(merged.chromaticAberration, overrides.chromaticAberration);
+    mergeFloat(merged.fresnelStrength, overrides.fresnelStrength);
+    mergeFloat(merged.specularStrength, overrides.specularStrength);
+    mergeFloat(merged.glassOpacity, overrides.glassOpacity);
+    mergeInt(merged.tintColor, overrides.tintColor);
+    mergeFloat(merged.brightness, overrides.brightness);
+    mergeFloat(merged.contrast, overrides.contrast);
+    mergeFloat(merged.saturation, overrides.saturation);
+    mergeFloat(merged.vibrancy, overrides.vibrancy);
+    mergeFloat(merged.vibrancyDarkness, overrides.vibrancyDarkness);
+    mergeFloat(merged.adaptiveDim, overrides.adaptiveDim);
+    mergeFloat(merged.adaptiveBoost, overrides.adaptiveBoost);
+    merged.optics = std::move(*mergedOptics);
+    target = std::move(merged);
+    return {};
+}
+
+std::expected<TPresetMap, SPresetConfigError> mergePresetMaps(TPresetMap builtIns, const TPresetMap& pending) {
+    for (const auto& [name, userPreset] : pending) {
+        if (auto iterator = builtIns.find(name); iterator != builtIns.end()) {
+            if (!userPreset.inherits.empty())
+                iterator->second.inherits = userPreset.inherits;
+            for (const auto& [target, source] : {
+                     std::pair{&iterator->second.shared, &userPreset.shared},
+                     std::pair{&iterator->second.dark, &userPreset.dark},
+                     std::pair{&iterator->second.light, &userPreset.light},
+                 }) {
+                if (source->optics.rim) {
+                    target->optics.legacyFresnelStrength.reset();
+                    target->optics.legacySpecularStrength.reset();
+                } else if (source->optics.legacyFresnelStrength || source->optics.legacySpecularStrength) {
+                    target->optics.rim.reset();
+                }
+                if (auto merged = mergePresetValues(*target, *source, name); !merged)
+                    return std::unexpected(merged.error());
+            }
+        } else {
+            builtIns.emplace(name, userPreset);
+        }
+    }
+    return builtIns;
+}
+
+std::expected<void, SPresetConfigError> stagePresetPatch(TPresetMap& pending, const SCustomPreset& patch) {
+    auto candidate = pending.contains(patch.name) ? pending.at(patch.name) : SCustomPreset{};
+    candidate.name = patch.name;
+    if (!patch.inherits.empty())
+        candidate.inherits = patch.inherits;
+    for (const auto& [target, source] : {
+             std::pair{&candidate.shared, &patch.shared},
+             std::pair{&candidate.dark, &patch.dark},
+             std::pair{&candidate.light, &patch.light},
+         }) {
+        if (auto merged = mergePresetValues(*target, *source, patch.name); !merged)
+            return std::unexpected(merged.error());
+    }
+    pending[patch.name] = std::move(candidate);
+    return {};
+}
+
+std::expected<SOpticalConfig, SPresetConfigError> resolvePresetOpticalConfig(
+    std::string_view presetName, bool isDark, const TPresetMap& presets,
+    const SOpticalConfigLayerOverrides& layers) {
+    auto defaults = resolveThemeDefaults(layers);
+    if (!defaults)
+        return std::unexpected(defaults.error());
+    SOpticalConfig base = isDark ? defaults->first : defaults->second;
+    return applyPresetOptics(std::move(base), presetName, isDark, presets, 0);
+}
+
+std::expected<SPresetConfigSnapshot, SPresetConfigError> buildPresetConfigSnapshot(
+    TPresetMap builtIns, const TPresetMap& pending, const SOpticalConfigLayerOverrides& layers) {
+    auto presets = mergePresetMaps(std::move(builtIns), pending);
+    if (!presets)
+        return std::unexpected(presets.error());
+    auto defaults = resolveThemeDefaults(layers);
+    if (!defaults)
+        return std::unexpected(defaults.error());
+
+    std::vector<std::string> names;
+    names.reserve(presets->size());
+    for (const auto& [name, preset] : *presets) {
+        (void)preset;
+        names.push_back(name);
+    }
+    std::ranges::sort(names);
+
+    std::unordered_map<std::string, SResolvedPresetOptics> resolved;
+    resolved.reserve(names.size());
+    for (const auto& name : names) {
+        auto dark = applyPresetOptics(defaults->first, name, true, *presets, 0);
+        if (!dark)
+            return std::unexpected(dark.error());
+        auto light = applyPresetOptics(defaults->second, name, false, *presets, 0);
+        if (!light)
+            return std::unexpected(light.error());
+        resolved.emplace(name, SResolvedPresetOptics{std::move(*dark), std::move(*light)});
+    }
+
+    return SPresetConfigSnapshot{
+        std::move(*presets), std::move(defaults->first), std::move(defaults->second), std::move(resolved)};
+}
+
+void SPresetRegistry::beginReload() {
+    m_pending.clear();
+    m_firstFailure.reset();
+    m_commitAttempted = false;
+    m_commitError.reset();
+}
+
+void SPresetRegistry::reject(SPresetConfigError error) {
+    if (!m_firstFailure)
+        m_firstFailure = std::move(error);
+}
+
+std::expected<void, SPresetConfigError> SPresetRegistry::stage(const SCustomPreset& patch) {
+    auto staged = stagePresetPatch(m_pending, patch);
+    if (!staged) {
+        reject(staged.error());
+        return std::unexpected(staged.error());
+    }
+    return {};
+}
+
+std::expected<std::reference_wrapper<const SPresetConfigSnapshot>, SPresetConfigError> SPresetRegistry::initialize(
+    TPresetMap builtIns, const SOpticalConfigLayerOverrides& layers) {
+    if (m_active)
+        return std::cref(*m_active);
+    auto snapshot = buildPresetConfigSnapshot(std::move(builtIns), {}, layers);
+    if (!snapshot)
+        return std::unexpected(snapshot.error());
+    m_active = std::move(*snapshot);
+    ++m_generation;
+    return std::cref(*m_active);
+}
+
+std::expected<std::reference_wrapper<const SPresetConfigSnapshot>, SPresetConfigError> SPresetRegistry::commit(
+    TPresetMap builtIns, const SOpticalConfigLayerOverrides& layers) {
+    if (m_commitAttempted) {
+        if (m_commitError)
+            return std::unexpected(*m_commitError);
+        return std::cref(*m_active);
+    }
+    m_commitAttempted = true;
+
+    if (m_firstFailure) {
+        m_commitError = m_firstFailure;
+        return std::unexpected(*m_commitError);
+    }
+    auto snapshot = buildPresetConfigSnapshot(std::move(builtIns), m_pending, layers);
+    if (!snapshot) {
+        m_commitError = snapshot.error();
+        return std::unexpected(*m_commitError);
+    }
+    m_active = std::move(*snapshot);
+    ++m_generation;
+    return std::cref(*m_active);
+}
+
+std::expected<std::reference_wrapper<const SPresetConfigSnapshot>, SPresetConfigError> SPresetRegistry::refreshLayers(
+    const SOpticalConfigLayerOverrides& layers) {
+    if (!m_active)
+        return std::unexpected(SPresetConfigError{"<runtime>", "transaction", "preset registry is not initialized"});
+    auto snapshot = buildPresetConfigSnapshot(m_active->presets(), {}, layers);
+    if (!snapshot)
+        return std::unexpected(snapshot.error());
+    m_active = std::move(*snapshot);
+    ++m_generation;
+    return std::cref(*m_active);
+}
+
+const SPresetConfigSnapshot* SPresetRegistry::active() const {
+    return m_active ? &*m_active : nullptr;
+}
