+[[nodiscard]] SRimMaterialInput shaderValues(const SRimMaterialInput& input) {
+    return {
+        .widthPx = shaderValue(input.widthPx),
+        .saturation = shaderValue(input.saturation),
+        .fresnelStrength = shaderValue(input.fresnelStrength),
+        .specularStrength = shaderValue(input.specularStrength),
+        .innerShadowStrength = shaderValue(input.innerShadowStrength),
+        .angleRadians = shaderValue(input.angleRadians),
+    };
+}
+
+[[nodiscard]] SOpticalConfigInput shaderValues(const SOpticalConfigInput& input) {
+    return {
+        .shapePower = shaderValue(input.shapePower),
+        .refractionCurve = shaderValues(input.refractionCurve),
+        .centeredMappingStrength = shaderValue(input.centeredMappingStrength),
+        .noiseStrength = shaderValue(input.noiseStrength),
+        .chromaticAberration = shaderValue(input.chromaticAberration),
+        .glow = shaderValues(input.glow),
+        .blurRadius = shaderValue(input.blurRadius),
+        .blurIterations = input.blurIterations == 0.0 ? 0.0 : input.blurIterations,
+        .snell = shaderValues(input.snell),
+        .rim = shaderValues(input.rim),
+    };
+}
+
+template <typename... Values>
+[[nodiscard]] auto makeBitsKey(Values... values) {
+    return SBitsKey<sizeof...(Values)>{{bits(static_cast<double>(values))...}};
+}
+
+[[nodiscard]] SBitsKey<COMPLETE_VALUE_COUNT> completeKey(const SOpticalConfigInput& input) {
+    return makeBitsKey(
+        input.shapePower,
+        input.refractionCurve.a, input.refractionCurve.b, input.refractionCurve.c,
+        input.refractionCurve.d, input.refractionCurve.power,
+        input.centeredMappingStrength, input.noiseStrength, input.chromaticAberration,
+        input.glow.weight, input.glow.bias, input.glow.edge0, input.glow.edge1,
+        input.blurRadius, input.blurIterations,
+        input.snell.widthPx, input.snell.thicknessPx, input.snell.refractiveIndex, input.snell.strength,
+        input.rim.widthPx, input.rim.saturation, input.rim.fresnelStrength, input.rim.specularStrength,
+        input.rim.innerShadowStrength, input.rim.angleRadians);
+}
+
+[[nodiscard]] SOpticalConfigError nonfiniteError(std::string path) {
+    return {EOpticalConfigError::NONFINITE, std::move(path), "must be finite"};
+}
+
+[[nodiscard]] SOpticalConfigError rangeError(std::string path, std::string_view range) {
+    return {EOpticalConfigError::OUT_OF_RANGE, std::move(path), std::string("must be in ") + std::string(range)};
+}
+
+[[nodiscard]] std::optional<SOpticalConfigError> validateRange(
+    double value, double minimum, double maximum, std::string path, std::string_view range) {
+    if (!std::isfinite(value))
+        return nonfiniteError(std::move(path));
+    if (value < shaderValue(minimum) || value > shaderValue(maximum))
+        return rangeError(std::move(path), range);
+    return std::nullopt;
+}
+
+[[nodiscard]] std::optional<SOpticalConfigError> validateRefractionCurveInput(const SRefractionCurveInput& input) {
+    if (auto error = validateRange(input.a, 0.0, 5.0, "refraction_curve.a", "[0, 5]"))
+        return error;
+    if (auto error = validateRange(input.b, 0.0, 6.0, "refraction_curve.b", "[0, 6]"))
+        return error;
+    if (auto error = validateRange(input.c, 0.001, 6.0, "refraction_curve.c", "[0.001, 6]"))
+        return error;
+    if (auto error = validateRange(input.d, 0.0, 10.0, "refraction_curve.d", "[0, 10]"))
+        return error;
+    return validateRange(input.power, 0.0, 6.0, "refraction_curve.power", "[0, 6]");
+}
+
+[[nodiscard]] std::optional<SOpticalConfigError> validateGlowInput(const SAngularGlowInput& input) {
+    if (auto error = validateRange(input.weight, -1.0, 1.0, "glow.weight", "[-1, 1]"))
+        return error;
+    if (auto error = validateRange(input.bias, -1.0, 1.0, "glow.bias", "[-1, 1]"))
+        return error;
+    if (auto error = validateRange(input.edge0, -1.0, 1.0, "glow.edge0", "[-1, 1]"))
+        return error;
+    return validateRange(input.edge1, -1.0, 1.0, "glow.edge1", "[-1, 1]");
+}
+
+[[nodiscard]] std::optional<SOpticalConfigError> validateSnellInput(const SConvexBezelInput& input) {
+    if (auto error = validateRange(input.widthPx, 0.0, 48.0, "snell.bezel_width", "[0, 48]"))
+        return error;
+    if (auto error = validateRange(input.thicknessPx, 0.0, 128.0, "snell.glass_thickness", "[0, 128]"))
+        return error;
+    if (auto error = validateRange(input.refractiveIndex, 1.0001, 2.0, "snell.refractive_index", "[1.0001, 2]"))
+        return error;
+    return validateRange(input.strength, 0.0, 1.0, "snell.strength", "[0, 1]");
+}
+
+[[nodiscard]] std::optional<SOpticalConfigError> validateRimInput(const SRimMaterialInput& input) {
+    if (auto error = validateRange(input.widthPx, 0.0, 4.0, "rim.width", "[0, 4]"))
+        return error;
+    if (auto error = validateRange(input.saturation, 0.0, 10.0, "rim.saturation", "[0, 10]"))
+        return error;
+    if (auto error = validateRange(input.fresnelStrength, 0.0, 1.0, "rim.fresnel_strength", "[0, 1]"))
+        return error;
+    if (auto error = validateRange(input.specularStrength, 0.0, 1.0, "rim.specular_strength", "[0, 1]"))
+        return error;
+    if (auto error = validateRange(input.innerShadowStrength, 0.0, 1.0, "rim.inner_shadow_strength", "[0, 1]"))
+        return error;
+    return validateRange(input.angleRadians, -std::numbers::pi, std::numbers::pi, "rim.angle", "[-pi, pi]");
+}
+
+[[nodiscard]] std::optional<SOpticalConfigError> validateStaticInput(const SOpticalConfigInput& input) {
+    if (auto error = validateRange(input.shapePower, 1.001, 6.0, "shape_power", "[1.001, 6]"))
+        return error;
+    if (auto error = validateRefractionCurveInput(input.refractionCurve))
+        return error;
+    if (auto error = validateRange(input.centeredMappingStrength, 0.0, 1.25, "refraction_strength", "[0, 1.25]"))
+        return error;
+    if (auto error = validateRange(input.noiseStrength, 0.0, 0.30, "noise_strength", "[0, 0.30]"))
+        return error;
+    if (auto error = validateRange(input.chromaticAberration, 0.0, 1.0, "chromatic_aberration", "[0, 1]"))
+        return error;
+    if (auto error = validateGlowInput(input.glow))
+        return error;
+    if (auto error = validateRange(input.blurRadius, 0.0, 10.0, "blur_strength", "[0, 10]"))
+        return error;
+    if (!std::isfinite(input.blurIterations))
+        return nonfiniteError("blur_iterations");
+    if (input.blurIterations < 0.0 || input.blurIterations > 5.0)
+        return rangeError("blur_iterations", "[0, 5]");
+    if (std::trunc(input.blurIterations) != input.blurIterations)
+        return SOpticalConfigError{EOpticalConfigError::FRACTIONAL_ITERATIONS, "blur_iterations", "must be an integer"};
+    if (auto error = validateSnellInput(input.snell))
+        return error;
+    return validateRimInput(input.rim);
+}
