+SOpticalConfig::SOpticalConfig(
+    double shapePower, SRefractionCurve refractionCurve, double centeredMappingStrength,
+    double noiseStrength, double chromaticAberration, SAngularGlow glow, double blurRadius,
+    int blurIterations, SConvexBezel snell, SRimMaterial rim, SOpticalValidationDiagnostics diagnostics) :
+    m_shapePower(shapePower), m_refractionCurve(std::move(refractionCurve)),
+    m_centeredMappingStrength(centeredMappingStrength), m_noiseStrength(noiseStrength),
+    m_chromaticAberration(chromaticAberration), m_glow(std::move(glow)), m_blurRadius(blurRadius),
+    m_blurIterations(blurIterations), m_snell(std::move(snell)), m_rim(std::move(rim)),
+    m_diagnostics(diagnostics) {}
