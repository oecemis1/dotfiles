+    }
+
+    for (const char* field : {"blur_iterations", "tint_color"}) {
+        lua_getfield(L, tableIndex, field);
+        if (lua_isnil(L, -1)) {
+            lua_pop(L, 1);
+            continue;
+        }
+        if (lua_type(L, -1) != LUA_TNUMBER) {
+            lua_pop(L, 1);
+            return std::unexpected(SPresetDiagnostic{std::string(preset), fieldPath(field), "must be a number"});
         }
+        int conversionSucceeded = 0;
