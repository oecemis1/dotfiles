@@ -0,0 +1,25 @@
+#pragma once
+
+#include <cstdint>
+#include <string_view>
+
+namespace MaterialIdentity {
+
+[[nodiscard]] constexpr std::uint32_t fnv1a32(std::string_view value) {
+    std::uint32_t hash = 2166136261U;
+    for (const char character : value) {
+        hash ^= static_cast<unsigned char>(character);
+        hash *= 16777619U;
+    }
+    return hash;
+}
+
+[[nodiscard]] constexpr std::uint32_t low24Seed(std::string_view value) {
+    return fnv1a32(value) & 0x00FFFFFFU;
+}
+
+[[nodiscard]] constexpr float shaderSeed(std::string_view value) {
+    return static_cast<float>(low24Seed(value));
+}
+
+} // namespace MaterialIdentity
