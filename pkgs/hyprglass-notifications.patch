+namespace SemanticGeometry {
+
+struct ClientId {
+    int descriptor;
+    [[nodiscard]] friend constexpr bool operator==(ClientId, ClientId) = default;
+};
+
+struct ClientIdHash {
+    [[nodiscard]] std::size_t operator()(ClientId id) const { return std::hash<int>{}(id.descriptor); }
+};
+
+class Hub {
+  public:
+    [[nodiscard]] UpdateResult clientConnected(ClientId id) {
+        auto [client, inserted] = m_clients.try_emplace(id);
+        if (!inserted)
+            return {};
+        auto result = client->second.clientConnected();
+        for (const auto& [token, name] : m_layers)
+            merge(result, client->second.layerMapped(token, name));
+        return result;
+    }
+
+    [[nodiscard]] UpdateResult ingest(ClientId id, std::string_view bytes) {
+        const auto client = m_clients.find(id);
+        return client == m_clients.end() ? UpdateResult{} : client->second.ingest(bytes);
+    }
+
+    [[nodiscard]] UpdateResult clientDisconnected(ClientId id) {
+        const auto client = m_clients.find(id);
+        if (client == m_clients.end())
+            return {};
+        auto result = client->second.clientDisconnected();
+        m_clients.erase(client);
+        return result;
+    }
+
+    [[nodiscard]] UpdateResult layerMapped(LayerToken token, std::string_view name) {
+        m_layers.insert_or_assign(token, std::string(name));
+        UpdateResult result;
+        for (auto& [id, client] : m_clients)
+            merge(result, client.layerMapped(token, name));
+        return result;
+    }
+
+    [[nodiscard]] UpdateResult layerUnmapped(LayerToken token) {
+        m_layers.erase(token);
+        UpdateResult result;
+        for (auto& [id, client] : m_clients)
+            merge(result, client.layerUnmapped(token));
+        return result;
+    }
+
+    [[nodiscard]] std::optional<Lookup> lookup(LayerToken token) const {
+        std::optional<Lookup> result;
+        for (const auto& [id, client] : m_clients) {
+            if (auto binding = client.lookup(token)) {
+                if (result)
+                    return std::nullopt;
+                result = std::move(binding);
+            }
+        }
+        return result;
+    }
+
+  private:
+    static void merge(UpdateResult& target, UpdateResult source) {
+        target.acceptedTransactions += source.acceptedTransactions;
+        target.rejectedTransactions += source.rejectedTransactions;
+        target.layerEffects.insert(target.layerEffects.end(),
+            std::make_move_iterator(source.layerEffects.begin()),
+            std::make_move_iterator(source.layerEffects.end()));
+    }
+
+    std::unordered_map<ClientId, State, ClientIdHash> m_clients;
+    std::unordered_map<LayerToken, std::string> m_layers;
+};
+
+} // namespace SemanticGeometry
