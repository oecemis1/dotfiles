@@ -0,0 +1,73 @@
+#include "GeometryHub.hpp"
+
+#include <cassert>
+#include <fstream>
+#include <iterator>
+#include <string>
+
+using namespace SemanticGeometry;
+
+static std::string frame(std::string_view name, std::string_view role,
+                         unsigned serial = 1, unsigned generation = 1) {
+    const auto prefix = std::string(name) + "\tsurface\t" + std::to_string(generation);
+    return "BEGIN\t1\t123\t" + std::to_string(serial) + "\t1\t2\t0\n" +
+        "SURFACE\t" + prefix + "\t1\n" +
+        "SHAPE\t" + prefix + "\tfront\t" + std::string(role) + "\t0\t0\t300\t100\t18\t-\n" +
+        "SHAPE\t" + prefix + "\tback\t" + std::string(role) + "\t8\t8\t284\t100\t17\t-\n" +
+        "COMMIT\t" + std::to_string(serial) + "\n";
+}
+
+int main(int argc, char** argv) {
+    for (int index = 1; index < argc; ++index) {
+        std::ifstream input(argv[index]);
+        assert(input.is_open());
+        const std::string wire{std::istreambuf_iterator<char>(input), {}};
+        State captured;
+        static_cast<void>(captured.clientConnected());
+        const auto replay = captured.ingest(wire);
+        assert(replay.acceptedTransactions > 0);
+        assert(replay.rejectedTransactions == 0);
+    }
+    Hub hub;
+    assert(hub.layerMapped(10, "quickshell").empty());
+    assert(hub.layerMapped(20, "notifications").empty());
+    assert(hub.clientConnected({1}).empty());
+    assert(hub.clientConnected({2}).empty());
+
+    // Existing non-overlapping protocol roles retain their strict validation.
+    assert(hub.ingest({1}, frame("quickshell", "control")).rejectedTransactions == 1);
+    assert(!hub.lookup(10));
+
+    // Stacks explicitly permit overlap and retain front-to-back declaration order.
+    assert(hub.ingest({2}, frame("notifications", "stack")).acceptedTransactions == 1);
+    auto notifications = hub.lookup(20);
+    assert(notifications && notifications->shapes().size() == 2);
+    assert(notifications->shapes()[0].id() == "front");
+    assert(notifications->shapes()[1].id() == "back");
+    assert(notifications->shapes()[0].role() == Role::STACK);
+
+    // An independent connection can use the same epoch and serial sequence.
+    assert(hub.ingest({1}, frame("quickshell", "stack")).acceptedTransactions == 1);
+    assert(hub.lookup(10));
+    assert(hub.lookup(20));
+    assert(hub.ingest({2}, frame("notifications", "stack", 2)).acceptedTransactions == 1);
+    assert(hub.lookup(10)->snapshot().serial() == 1);
+    assert(hub.lookup(20)->snapshot().serial() == 2);
+
+    // Disconnecting the notification daemon does not tear down Quickshell.
+    assert(!hub.clientDisconnected({2}).empty());
+    assert(!hub.lookup(20));
+    assert(hub.lookup(10));
+    assert(hub.clientDisconnected({2}).empty());
+
+    // A new publisher binds already-mapped layers, including after remapping.
+    assert(hub.clientConnected({3}).empty());
+    assert(hub.ingest({3}, frame("notifications", "stack")).acceptedTransactions == 1);
+    assert(hub.lookup(20));
+    assert(!hub.layerUnmapped(20).empty());
+    assert(!hub.lookup(20));
+    static_cast<void>(hub.layerMapped(21, "notifications"));
+    assert(hub.ingest({3}, frame("notifications", "stack", 2, 2)).acceptedTransactions == 1);
+    assert(hub.lookup(21));
+    assert(hub.lookup(10));
+}
